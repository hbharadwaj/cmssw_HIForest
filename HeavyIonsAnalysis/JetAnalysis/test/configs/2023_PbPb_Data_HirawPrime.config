# 2023 PbPb QCDPhoton Configuration

# Processing Control
Verbose 1
FileLimit 99999
FilesPerOutput 150
BatchMode 0

# I/O Configuration
InputDir /eos/cms/store/group/phys_heavyions/bharikri/Forest/GammaJetSubstructure/2023_PbPb_Data/
OutputDir /eos/cms/store/group/phys_heavyions/bharikri/Run3GammaJet/2025_06_03/2023_PbPb/Data/
OutName 2025_06_03_Data_HiRawPrimeAll_part_skimmed

# Event Selection
# SelectionCuts pprimaryVertexFilter pclusterCompatibilityFilter pphfCoincFilter2Th4
# TriggerBits HLT_HIGEDPhoton30_v1
# CentralityMax 180
# VzMax 15

# Trees and Collections
# hiEvtAnalyzer/HiTree should be the first tree in the list. Base Tree
Trees hiEvtAnalyzer/HiTree:hiEvt ggHiNtuplizer/EventTree:ggHi skimanalysis/HltTree:skim hltanalysis/HltTree:hlt akCs2PFJetAnalyzerSDZcut1/t:AK2Z1 akCs2PFJetAnalyzerSDZcut2/t:AK2Z2 akCs2PFJetAnalyzerSDZcut3/t:AK2Z3  akCs3PFJetAnalyzerSDZcut1/t:AK3Z1 akCs3PFJetAnalyzerSDZcut2/t:AK3Z2 akCs3PFJetAnalyzerSDZcut3/t:AK3Z3   akCs4PFJetAnalyzerSDZcut1/t:AK4Z1 akCs4PFJetAnalyzerSDZcut2/t:AK4Z2 akCs4PFJetAnalyzerSDZcut3/t:AK4Z3   akCs5PFJetAnalyzerSDZcut1/t:AK5Z1 akCs5PFJetAnalyzerSDZcut2/t:AK5Z2 akCs5PFJetAnalyzerSDZcut3/t:AK5Z3  akCs6PFJetAnalyzerSDZcut1/t:AK6Z1 akCs6PFJetAnalyzerSDZcut2/t:AK6Z2 akCs6PFJetAnalyzerSDZcut3/t:AK6Z3 akCs8PFJetAnalyzerSDZcut1/t:AK8Z1 akCs8PFJetAnalyzerSDZcut2/t:AK8Z2 akCs8PFJetAnalyzerSDZcut3/t:AK8Z3 

# Branch Selection - matching the tree paths exactly
Branches_hiEvtAnalyzer/HiTree run,evt,lumi,vx,vy,vz,hiBin,hiHF

