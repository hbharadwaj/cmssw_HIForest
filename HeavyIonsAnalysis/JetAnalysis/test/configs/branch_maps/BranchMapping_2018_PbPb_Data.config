# Branch Mapping Configuration for 2018 PbPb Data (RENAMED format)
# This file maps the RENAMED 2018 data branch names to the expected framework names
# Use this config for 2018 files that have been processed with rename_2018_branches.C
#
# File structure after renaming:
# - Scalar photon branches with ggHi_ prefix: ggHi_phoEt, ggHi_phoEta, etc.
# - Jet branches with AK2Z2_ prefix: AK2Z2_nref, AK2Z2_jtpt, etc.
# - Modern substructure names: AK2Z2_jtdyn_z, AK2Z2_jtdyn_deltaR, AK2Z2_jt_girth

# ========================================
# Format Metadata
# ========================================
Format.Year: 2018
Format.PhotonMode: SCALAR
Format.HasJetCollectionPrefix: yes
Photon.nPho: 1

# ========================================
# Event-Level Branches
# ========================================
EventLevel.hiBin: hiBin
EventLevel.rho: rho
EventLevel.vz: MISSING
EventLevel.hiHF: MISSING

# ========================================
# Photon Branches (Scalar after renaming)
# ========================================
# Actual branches in renamed file (from BranchList2018Data.txt):
# - ggHi_phoEt, phoEtCorrected, ggHi_phoEta, ggHi_phoPhi, ggHi_phoHoverE
# - phoSigmaIEtaIEta_2012, phoSigmaEtaEta_2012
# - ggHi_pho_ecalClusterIsoR3, ggHi_pho_hcalRechitIsoR3, ggHi_pho_trackIsoR3PtCut20
# - ggHi_pfcIso3subUEec, ggHi_pfnIso3subUEec, ggHi_pfpIso3subUEec

Photon.phoEt: phoEtCorrected
Photon.phoEta: ggHi_phoEta
Photon.phoPhi: ggHi_phoPhi
Photon.phoHoverE: ggHi_phoHoverE
Photon.phoSigmaIEtaIEta: phoSigmaIEtaIEta_2012
Photon.phoSigmaEtaEta: phoSigmaEtaEta_2012
Photon.phoECALIso: ggHi_pho_ecalClusterIsoR3
Photon.phoHCALIso: ggHi_pho_hcalRechitIsoR3
Photon.phoTrackIso: ggHi_pho_trackIsoR3PtCut20
Photon.pfcIso: ggHi_pfcIso3subUEec
Photon.pfnIso: ggHi_pfnIso3subUEec
Photon.pfpIso: ggHi_pfpIso3subUEec
Photon.phoR9: MISSING

# ========================================
# Jet Branches (with collection prefix after renaming)
# ========================================
# Use _nref, _jtpt pattern - BranchMapper will prepend collection name
Jet.nref: _nref
Jet.jtpt: _jtpt
Jet.jteta: _jteta
Jet.jtphi: _jtphi
Jet.jtm: MISSING
Jet.jtarea: MISSING

# ========================================
# Substructure Variables (with collection prefix)
# ========================================
Substructure.jtdyn_split: MISSING
Substructure.jtdyn_z: _jtdyn_z
Substructure.jtdyn_kt: _jtdyn_kt
Substructure.jtdyn_deltaR: _jtdyn_deltaR
Substructure.jt_girth: _jt_girth
Substructure.jt_thrust: MISSING
Substructure.jt_LHA: MISSING
Substructure.jt_pTD: MISSING
Substructure.jt_tau_form: MISSING

# ========================================
# MC/Ref Jet Branches (with collection prefix)
# ========================================
MC.refpt: _refpt
MC.refeta: _refeta
MC.refphi: _refphi
MC.refm: MISSING
MC.refdyn_z: _refdyn_z
MC.refdyn_kt: _refdyn_kt
MC.refdyn_deltaR: _refdyn_deltaR
MC.ref_girth: _ref_girth

# ========================================
# Trigger Branches
# ========================================
Trigger.L1: L1_SingleEG21_BptxAND
Trigger.HLT: HLT_HIGEDPhoton40_v1
