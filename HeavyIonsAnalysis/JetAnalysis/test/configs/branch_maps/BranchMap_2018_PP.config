# Branch Mapping Configuration for 2018 PP Format
# Inherits most settings from 2018_PbPb, but with PP-specific differences

# ============================================================================
# Format Metadata
# ============================================================================
Format.Year: 2018
Format.System: PP
Format.PhotonMode: SCALAR
Format.HasJetCollectionPrefix: false

# ============================================================================
# Event-Level Branches (PP: No Centrality)
# ============================================================================
EventLevel.hiBin: MISSING
EventLevel.vz: MISSING
EventLevel.hiHF: MISSING
EventLevel.rho: rho

# ============================================================================
# Photon Branches (Scalar)
# ============================================================================
Photon.nPho: 1
Photon.phoEt: phoEtCorrected
Photon.phoEta: phoEta
Photon.phoPhi: phoPhi
Photon.phoHoverE: phoHoverE
Photon.phoSigmaIEtaIEta: phoSigmaIEtaIEta_2012
Photon.phoSigmaEtaEta: phoSigmaEtaEta_2012
Photon.phoECALIso: pho_ecalClusterIsoR3
Photon.phoHCALIso: pho_hcalRechitIsoR3
Photon.phoTrackIso: pho_trackIsoR3PtCut20
Photon.pfcIso: pfcIso3subUE
Photon.pfnIso: pfnIso3subUE
Photon.pfpIso: pfpIso3subUE
Photon.phoR9: MISSING
Photon.eleRej: eleRej
Photon.phoSCEta: phoSCEta
Photon.phoSCPhi: phoSCPhi
Photon.phoSCRawE: phoSCRawE

# ============================================================================
# Jet Branches
# ============================================================================
Jet.nref: nref
Jet.jtpt: jtpt
Jet.jteta: jteta
Jet.jtphi: jtphi
Jet.jtm: MISSING
Jet.jtarea: MISSING
Jet.jet_index: jet_index

# ============================================================================
# Jet Substructure
# ============================================================================
Substructure.jtdyn_split: jtsym
Substructure.jtdyn_z: jtrg
Substructure.jtdyn_kt: jtdynkt
Substructure.jtdyn_deltaR: jtangu
Substructure.jt_girth: MISSING
Substructure.jt_thrust: MISSING
Substructure.jt_LHA: MISSING
Substructure.jt_pTD: MISSING
Substructure.jt_tau_form: MISSING

# ============================================================================
# MC/Reference Jet Branches
# ============================================================================
MC.refpt: refpt
MC.refeta: refeta
MC.refphi: refphi
MC.refdyn_split: refsym
MC.refdyn_z: refrg
MC.refdyn_kt: refdynkt
MC.refdyn_deltaR: refangu

# ============================================================================
# Triggers (PP-specific - may differ from PbPb)
# ============================================================================
# Note: Update these if PP uses different trigger names
Trigger.L1: L1_SingleEG21_BptxAND
Trigger.HLT: HLT_HIGEDPhoton40_v1
