# Branch Mapping Configuration for 2023/2024 Format
# Unified config for both PbPb and PP systems (2023 and 2024 share same branch structure)
#
# Format characteristics:
# - Vector photons with "ggHi_" prefix
# - Jet branches have collection prefix (e.g., "AK2Z2_jtpt")
# - Full substructure variables available
# - PP vs PbPb distinguished by presence of hiBin branch (handled dynamically)

# ============================================================================
# Format Metadata
# ============================================================================
Format.Year: 2023
Format.PhotonMode: VECTOR
Format.HasJetCollectionPrefix: true

# ============================================================================
# Event-Level Branches
# ============================================================================
EventLevel.hiBin: hiBin
EventLevel.vz: vz
EventLevel.hiHF: hiHF
EventLevel.rho: ggHi_rho

# ============================================================================
# Photon Branches (Vector with ggHi_ Prefix)
# ============================================================================
Photon.nPho: ggHi_nPho
Photon.phoEt: ggHi_phoEt
Photon.phoEta: ggHi_phoEta
Photon.phoPhi: ggHi_phoPhi
Photon.phoHoverE: ggHi_phoHoverE
Photon.phoSigmaIEtaIEta: ggHi_phoSigmaIEtaIEta_2012
Photon.phoSigmaEtaEta: ggHi_phoSigmaEtaEta_2012
Photon.phoECALIso: ggHi_pho_ecalClusterIsoR3
Photon.phoHCALIso: ggHi_pho_hcalRechitIsoR3
Photon.phoTrackIso: ggHi_pho_trackIsoR3PtCut20
Photon.pfcIso: ggHi_pfcIso3subUEec
Photon.pfnIso: ggHi_pfnIso3subUEec
Photon.pfpIso: ggHi_pfpIso3subUEec
Photon.phoR9: ggHi_phoR9_2012
Photon.eleRej: MISSING
Photon.SumPFIso: ggHi_SumPFIso
Photon.SumCalIso: ggHi_SumCalIso

# ============================================================================
# Jet Branches (With {COLLECTION}_ Prefix)
# ============================================================================
# Note: These will be prepended with collection name (e.g., "AK2Z2_nref")
# The underscore prefix indicates this is a suffix to be added to collection name
Jet.nref: _nref
Jet.jtpt: _jtpt
Jet.jteta: _jteta
Jet.jtphi: _jtphi
Jet.jtm: _jtm
Jet.jtarea: _jtarea
Jet.jtpu: _jtpu
Jet.rawpt: _rawpt

# ============================================================================
# Jet Substructure (Full Set Available)
# ============================================================================
Substructure.jtdyn_split: _jtdyn_split
Substructure.jtdyn_z: _jtdyn_z
Substructure.jtdyn_kt: _jtdyn_kt
Substructure.jtdyn_deltaR: _jtdyn_deltaR
Substructure.jtdyn_eta: _jtdyn_eta
Substructure.jtdyn_phi: _jtdyn_phi
Substructure.jt_girth: _jtgirth
Substructure.jt_thrust: _jt_thrust
Substructure.jt_LHA: _jt_LHA
Substructure.jt_pTD: _jt_pTD
Substructure.jt_tau_form: _jt_tau_form
Substructure.jt_intjet_multi: _jt_intjet_multi

# ============================================================================
# MC/Reference Jet Branches (With Collection Prefix)
# ============================================================================
MC.pthat: _pthat
MC.refpt: _refpt
MC.refeta: _refeta
MC.refphi: _refphi
MC.refm: _refm
MC.refarea: _refarea
MC.refdyn_split: _refdyn_split
MC.refdyn_z: _refdyn_z
MC.refdyn_kt: _refdyn_kt
MC.refdyn_deltaR: _refdyn_deltaR
MC.refdyn_eta: _refdyn_eta
MC.refdyn_phi: _refdyn_phi
MC.ref_girth: _ref_girth
MC.ref_thrust: _ref_thrust
MC.ref_LHA: _ref_LHA
MC.ref_pTD: _ref_pTD
MC.ref_tau_form: _ref_tau_form
MC.ref_intjet_multi: _ref_intjet_multi
MC.refparton_pt: _refparton_pt
MC.refparton_flavor: _refparton_flavor
MC.refparton_flavorForB: _refparton_flavorForB
MC.genChargedSum: _genChargedSum
MC.genHardSum: _genHardSum
MC.signalChargedSum: _signalChargedSum
MC.signalHardSum: _signalHardSum

# ============================================================================
# Gen-level Jets (For MC)
# ============================================================================
MC.ngen: _ngen
MC.genmatchindex: _genmatchindex
MC.genpt: _genpt
MC.geneta: _geneta
MC.genphi: _genPhi
MC.genm: _genm
MC.gendyn_split: _gendyn_split
MC.gendyn_z: _gendyn_z
MC.gendyn_kt: _gendyn_kt
MC.gendyn_deltaR: _gendyn_deltaR
MC.gendyn_eta: _gendyn_eta
MC.gendyn_phi: _gendyn_phi
MC.gen_girth: _gen_girth
MC.gen_thrust: _gen_thrust
MC.gen_LHA: _gen_LHA
MC.gen_pTD: _gen_pTD
MC.gen_tau_form: _gen_tau_form
MC.gen_intjet_multi: _gen_intjet_multi

# ============================================================================
# MC Truth Particles (gen-level particles)
# ============================================================================
MC.nMC: ggHi_nMC
MC.mcPID: ggHi_mcPID
MC.mcMomPID: ggHi_mcMomPID
MC.mcPt: ggHi_mcPt
MC.mcEta: ggHi_mcEta
MC.mcPhi: ggHi_mcPhi
MC.mcStatus: ggHi_mcStatus
MC.mcCalIsoDR04: ggHi_mcCalIsoDR04
MC.pho_genMatchedIndex: ggHi_pho_genMatchedIndex

# ============================================================================
# Event-level MC Weights
# ============================================================================
MC.weight: weight
MC.weight_pthat: weight_pthat

# ============================================================================
# Triggers
# ============================================================================
# Note: Trigger names may vary by year and system
# These are common ones, add more as needed per dataset
Trigger.L1_SingleEG21: L1_SingleEG21_BptxAND
Trigger.HLT_Photon40: HLT_HIGEDPhoton40_v1

# ============================================================================
# Notes
# ============================================================================
# - For PP data, hiBin/hiHF will be dynamically detected as MISSING
# - The underscore prefix on jet/MC branches indicates they should be prepended
#   with the collection name (e.g., "_jtpt" becomes "AK2Z2_jtpt")
# - This config works for both 2023 and 2024 as they share the same branch structure
