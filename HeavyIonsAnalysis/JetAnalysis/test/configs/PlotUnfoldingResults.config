# =============================================================================
# Unfolding Results Plotting Configuration
# =============================================================================
# This file defines all plotting options for unfolding results visualization.
# Based on the structure of PlotJetSub_2023_PbPb_Data.config
# 
# Author: CMS Heavy Ion Team
# Date: 2025-07-14
# =============================================================================

# =============================================================================
# GENERAL PLOTTING SETTINGS
# =============================================================================

# Plot output formats (comma-separated)
PlotFormats: png,root,pdf

# CMS Style and Labeling
CMSLabel: Preliminary
CMSEnergyText: 5.36 TeV PbPb
CMSLuminosity: 1.72 nb^{-1}
CMSExtraText: 

# Color scheme selection (petroff6, petroff10, viridis, traditional)
ColorScheme: petroff6
UseColorBlind: 1

# Canvas settings
Canvas.Width: 800
Canvas.Height: 600
Canvas.LeftMargin: 0.15
Canvas.RightMargin: 0.05
Canvas.TopMargin: 0.08
Canvas.BottomMargin: 0.12

# =============================================================================
# UNFOLDING SETS AND TESTS TO PROCESS
# =============================================================================

# List of unfolding sets to plot (comma-separated, or "all" for automatic detection)
UnfoldingSets: Unfold1D_xJ,Unfold2D_girth_xJ,Unfold2D_dyn_deltaR_xJ

# List of tests to plot (comma-separated, or "all" for automatic detection)
Tests: Nominal,Closure,Split,Bottomline

# =============================================================================
# HISTOGRAM TYPES TO PLOT
# =============================================================================

# Individual histogram plots
PlotMeasured: 1
PlotTruth: 1
PlotUnfolded: 1
PlotEfficiency: 1
PlotPurity: 1
PlotResponse: 1

# 2D histogram projections
CreateProjections: 1
ProjectionAxes: x,y

# =============================================================================
# COMPARISON PLOTS
# =============================================================================

# Enable comparison plots
CreateComparisonPlots: 1

# Unfolded vs Truth comparisons
CompareUnfoldedTruth: 1
CompareMeasuredTruth: 1

# Ratio plots
CreateRatioPlots: 1
Ratio.UnfoldedOverTruth: 1
Ratio.MeasuredOverTruth: 1
Ratio.Min: 0.5
Ratio.Max: 1.5
Ratio.YTitle: Ratio

# Multi-test overlays (compare different tests for same unfolding set)
CreateTestOverlays: 1
TestOverlay.Types: h_unfolded,h_efficiency,h_purity

# =============================================================================
# AXIS LABELS AND TITLES
# =============================================================================

# Variable-specific axis labels (override automatic detection)
AxisLabel.xj_AK2Z2: x_{J,#gamma}
AxisLabel.refxj_AK2Z2: x_{J,#gamma}^{truth}
AxisLabel.jetGirth_AK2Z2: Girth
AxisLabel.refJetGirth_AK2Z2: Girth^{truth}
AxisLabel.jetDynDeltaR_AK2Z2: #sqrt{z#theta}
AxisLabel.refJetDynDeltaR_AK2Z2: #sqrt{z#theta}^{truth}
AxisLabel.jetDynKt_AK2Z2: dyn k_{T}
AxisLabel.refJetDynKt_AK2Z2: dyn k_{T}^{truth}
AxisLabel.photonEt: E_{T}^{#gamma} [GeV]
AxisLabel.MCphotonEt: E_{T}^{#gamma,truth} [GeV]

# Default Y-axis labels
YLabel.Default: Entries
YLabel.Efficiency: Efficiency
YLabel.Purity: Purity
YLabel.Ratio: Ratio

# =============================================================================
# CANVAS AND MATRIX STORAGE
# =============================================================================

# Store existing canvases (Response, Covariance, Probability matrices)
StoreCanvases: 1
CreateMatrixSubdir: 1

# Matrix-specific settings
Matrix.SaveFormats: png,pdf
Matrix.Subdir: matrices

# =============================================================================
# PROJECTION SETTINGS
# =============================================================================

# For 2D histograms, create projections
Projection.XAxis: 1
Projection.YAxis: 1

# Projection bin ranges (format: unfold_set:axis:min:max, or "all" for full range)
# Example: Unfold2D_girth_xJ:x:1:5 means project X-axis from bin 1 to 5
Projection.Ranges: all

# Projection naming
Projection.XSuffix: _projX
Projection.YSuffix: _projY

# =============================================================================
# OVERLAY SETTINGS
# =============================================================================

# Legend settings for overlays
Legend.Position: 0.65,0.65,0.90,0.88
Legend.TextSize: 0.035
Legend.BorderSize: 0
Legend.FillStyle: 0

# Test comparison colors (will cycle through color palette)
TestColors.Nominal: auto
TestColors.Closure: auto
TestColors.Split: auto
TestColors.Bottomline: auto

# =============================================================================
# ADVANCED PLOTTING OPTIONS
# =============================================================================

# Logarithmic scales
LogY.Default: 0
LogZ.Default: 0

# Auto-adjust Y-axis ranges
AutoAdjustYRange: 1
YRangeMarginTop: 0.1
YRangeMarginBottom: 0.0

# Error bars
ShowErrorBars: 1
ErrorBarStyle: 0

# Grid lines
ShowGridX: 0
ShowGridY: 0

# Marker and line styles
MarkerSize: 0.8
LineWidth: 2
MarkerStyle.Default: 20

# =============================================================================
# OUTPUT ORGANIZATION
# =============================================================================

# Directory structure for output
CreateUnfoldingSetDirs: 1
CreateTestDirs: 1
CreateComparisonDirs: 1

# Subdirectory names
SubDir.Individual: individual_plots
SubDir.Comparisons: comparisons
SubDir.TestOverlays: test_comparisons
SubDir.Matrices: matrices
SubDir.Projections: projections

# =============================================================================
# FILE OVERLAY SETTINGS (for comparing multiple input files)
# =============================================================================

# Enable multi-file overlays
EnableMultiFileOverlay: 0

# File labels for overlays (if multiple input files provided)
FileLabel.0: File 1
FileLabel.1: File 2
FileLabel.2: File 3

# =============================================================================
# DEBUGGING AND VERBOSITY
# =============================================================================

# Verbose output
Verbose: 0

# Test mode (process limited number of plots)
TestMode: 0
TestMode.MaxPlots: 10

# =============================================================================
# HISTOGRAM SELECTION FILTERS
# =============================================================================

# Specific histograms to include/exclude (comma-separated, or "all")
IncludeHistograms: all
ExcludeHistograms: 

# Specific tests to include/exclude
IncludeTests: all
ExcludeTests: 

# Specific unfolding sets to include/exclude
IncludeUnfoldingSets: all
ExcludeUnfoldingSets: 

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
