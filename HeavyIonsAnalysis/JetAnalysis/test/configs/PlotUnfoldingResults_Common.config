# =============================================================================
# Common Unfolding Results Plotting Configuration
# =============================================================================
# This file defines common plotting options for unfolding results visualization.
# System-specific files should include this and override as needed.
# 
# Author: CMS Heavy Ion Team
# Date: 2025-07-14
# =============================================================================

# =============================================================================
# GENERAL PLOTTING SETTINGS
# =============================================================================

# Plot output formats (comma-separated)
PlotFormats: png,root
#,pdf

# CMS Style and Labeling
CMSLabel: Preliminary
CMSEnergyText: 5.36 TeV
CMSLuminosity: 1.72 nb^{-1}
CMSExtraText: 

# Color scheme selection
ColorScheme: petroff6
UseColorBlind: 1

# Canvas settings
Canvas.Width: 800
Canvas.Height: 600
Canvas.LeftMargin: 0.15
Canvas.RightMargin: 0.1
Canvas.TopMargin: 0.08
Canvas.BottomMargin: 0.12

# =============================================================================
# HISTOGRAM TYPES TO PLOT
# =============================================================================

# Individual histogram plots
PlotMeasured: 1
PlotTruth: 1
PlotUnfolded: 1
PlotEfficiency: 1
PlotPurity: 1
PlotResponse: 1

# 2D histogram projections
CreateProjections: 1
ProjectionAxes: x,y

# =============================================================================
# COMPARISON PLOTS
# =============================================================================

# Enable comparison plots
CreateComparisonPlots: 1

# Unfolded vs Truth comparisons
CompareUnfoldedTruth: 1
CompareMeasuredTruth: 1

# Ratio plots
CreateRatioPlots: 1
Ratio.UnfoldedOverTruth: 1
Ratio.MeasuredOverTruth: 0
Ratio.Min: 0.5
Ratio.Max: 1.5
Ratio.YTitle: Ratio

# Multi-test overlays (compare different tests for same unfolding set)
CreateTestOverlays: 1
TestOverlay.Types: h_unfolded,h_efficiency,h_purity

# Method comparison (for different unfolding methods)
CreateMethodOverlays: 1
MethodOverlay.Types: h_unfolded,h_measured_data

# Iteration comparison (for Bayes unfolding)
CreateIterationOverlays: 1
IterationOverlay.Methods: Bayes
IterationOverlay.Iterations: 1,5,10,15,20,25

# =============================================================================
# AXIS LABELS AND TITLES
# =============================================================================

# Variable-specific axis labels (core variable names, automatically handles jet collection suffixes)
AxisLabel.xj: x_{J,#gamma}
AxisLabel.refxj: x_{J,#gamma}^{truth}
AxisLabel.jetGirth: Girth
AxisLabel.refJetGirth: Girth^{truth}
AxisLabel.jetDynDeltaR: R_{g}
AxisLabel.refJetDynDeltaR: R_{g}^{truth}
AxisLabel.jetDynKt: dyn k_{T} [GeV]
AxisLabel.refJetDynKt: dyn k_{T}^{truth} [GeV]
AxisLabel.jetDynSplit: n_{SD}
AxisLabel.refJetDynSplit: n_{SD}^{truth}
AxisLabel.jetDynZ: z_{g}
AxisLabel.refJetDynZ: z_{g}^{truth}
AxisLabel.jetPt: p_{T}^{jet} [GeV]
AxisLabel.refJetPt: p_{T}^{jet,truth} [GeV]
AxisLabel.jetEta: #eta^{jet}
AxisLabel.refJetEta: #eta^{jet,truth}
AxisLabel.jetPhi: #phi^{jet}
AxisLabel.refJetPhi: #phi^{jet,truth}
AxisLabel.jetMass: m^{jet} [GeV]
AxisLabel.refJetMass: m^{jet,truth} [GeV]
AxisLabel.photonEt: E_{T}^{#gamma} [GeV]
AxisLabel.MCphotonEt: E_{T}^{#gamma,truth} [GeV]
AxisLabel.photonEta: #eta^{#gamma}
AxisLabel.MCphotonEta: #eta^{#gamma,truth}

# Default Y-axis labels
YLabel.Default: Entries
YLabel.Efficiency: Efficiency
YLabel.Purity: Purity
YLabel.Ratio: Ratio

# Unfolding set specific axis labels
Unfold1D_xJ.XAxis: x_{J,#gamma}
Unfold1D_xJ.YAxis: Entries

Unfold2D_girth_xJ.XAxis: Girth
Unfold2D_girth_xJ.YAxis: x_{J,#gamma}

Unfold2D_dyn_deltaR_xJ.XAxis: R_{g}
Unfold2D_dyn_deltaR_xJ.YAxis: x_{J,#gamma}

Unfold2D_dyn_kt_xJ.XAxis: dyn k_{T} [GeV]
Unfold2D_dyn_kt_xJ.YAxis: x_{J,#gamma}

Unfold2D_dyn_z_xJ.XAxis: z_{g}
Unfold2D_dyn_z_xJ.YAxis: x_{J,#gamma}

# Normalized Y-axis labels for projections
YLabel.Normalized.xj: #frac{1}{N_{jet}} #frac{dN}{dx_{J,#gamma}}
YLabel.Normalized.jetGirth: #frac{1}{N_{jet}} #frac{dN}{dGirth}
YLabel.Normalized.jetDynDeltaR: #frac{1}{N_{jet}} #frac{dN}{dR_{g}}
YLabel.Normalized.jetDynKt: #frac{1}{N_{jet}} #frac{dN}{dk_{T}} [GeV^{-1}]
YLabel.Normalized.jetDynZ: #frac{1}{N_{jet}} #frac{dN}{dz_{g}}

# =============================================================================
# CANVAS AND MATRIX STORAGE
# =============================================================================

# Store existing canvases (Response, Covariance, Probability matrices)
StoreCanvases: 1
CreateMatrixSubdir: 1

# Matrix-specific settings
Matrix.SaveFormats: png,pdf
Matrix.Subdir: matrices

# =============================================================================
# PROJECTION SETTINGS
# =============================================================================

# For 2D histograms, create projections
Projection.XAxis: 1
Projection.YAxis: 1

# Projection bin ranges (format: unfold_set:axis:min:max, or "all" for full range)
Projection.Ranges: all

# Projection naming
Projection.XSuffix: _projX
Projection.YSuffix: _projY

# =============================================================================
# OVERLAY SETTINGS
# =============================================================================

# Legend settings for overlays
Legend.Position: 0.65,0.65,0.90,0.88
Legend.TextSize: 0.035
Legend.BorderSize: 0
Legend.FillStyle: 0

# Color schemes for different overlay types
ColorScheme.Test: test_comparison
ColorScheme.Method: method_comparison
ColorScheme.Iteration: iteration_comparison
ColorScheme.Default: petroff6

# =============================================================================
# ADVANCED PLOTTING OPTIONS
# =============================================================================

# Logarithmic scales
LogY.Default: 0
LogZ.Default: 0

# Auto-adjust Y-axis ranges
AutoAdjustYRange: 1
YRangeMarginTop: 0.1
YRangeMarginBottom: 0.0

# Error bars
ShowErrorBars: 1
ErrorBarStyle: 0

# Grid lines
ShowGridX: 0
ShowGridY: 0

# Marker and line styles
MarkerSize: 0.8
LineWidth: 2
MarkerStyle.Default: 20

# 2D Histogram default draw option
Histogram.Default.DrawOption2D: TEXT_COLZ

# =============================================================================
# OUTPUT ORGANIZATION
# =============================================================================

# Directory structure for output
CreateUnfoldingSetDirs: 1
CreateTestDirs: 1
CreateComparisonDirs: 1

# Subdirectory names
SubDir.Individual: individual_plots
SubDir.Comparisons: comparisons
SubDir.TestOverlays: test_comparisons
SubDir.MethodOverlays: method_comparisons
SubDir.IterationOverlays: iteration_comparisons
SubDir.Matrices: matrices
SubDir.Projections: projections

# =============================================================================
# FILE OVERLAY SETTINGS (for comparing multiple input files)
# =============================================================================

# Enable multi-file overlays
EnableMultiFileOverlay: 1

# =============================================================================
# DEBUGGING AND VERBOSITY
# =============================================================================

# Verbose output
Verbose: 0

# Test mode (process limited number of plots)
TestMode: 0
TestMode.MaxPlots: 10

# =============================================================================
# HISTOGRAM SELECTION FILTERS
# =============================================================================

# Specific histograms to include (whitelist approach)
IncludeHistograms: h_data_purity_corrected,h_measured_mc,h_truth_mc,h_unfolded_corrected,h_purity,h_efficiency,Fakes_histogram_flattened

# Specific tests to include/exclude
IncludeTests: all
ExcludeTests: 

# Specific unfolding sets to include/exclude
IncludeUnfoldingSets: all
ExcludeUnfoldingSets: 

# =============================================================================
# UNFOLDING METHOD SPECIFIC SETTINGS
# =============================================================================

# Method-specific histogram patterns
Method.Bayes.Pattern: *Bayes*,*bayes*
Method.MatrixInversion.Pattern: *Invert*,*invert*,*Matrix*,*matrix*
Method.SVD.Pattern: *SVD*,*svd*
Method.BinByBin.Pattern: *BinByBin*,*binbybin*

# Iteration-specific patterns for Bayes
Iteration.Pattern: *_iter*,*_iteration*

# =============================================================================
# END OF COMMON CONFIGURATION
# =============================================================================
