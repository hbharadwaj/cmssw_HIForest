# =============================================================================
# Centralized Histogram Configuration for Gamma-Jet Analysis
# =============================================================================
# This file contains all histogram definitions for Data, MC, and Overlay plotting.
# Use Histogram.Default.* for global defaults, and Histogram.<Name>.* for overrides.
#
# Author: CMS Heavy Ion Analysis
# Date: 2025-06-03
# =============================================================================

# =============================================================================
# DEFAULTS (applies to all unless overridden)
# =============================================================================
Histogram.Default.Bins: 50
Histogram.Default.XMin: 0
Histogram.Default.XMax: 100
Histogram.Default.LogY: 0
Histogram.Default.PlotType: TH1F
Histogram.Default.Color: auto
Histogram.Default.LineWidth: 2
Histogram.Default.DrawOption: E1][P0]
Histogram.Default.MarkerStyle: kFullCircle
Histogram.Default.MarkerSize: 0.8

# =============================================================================
# BASIC KINEMATIC HISTOGRAMS
# =============================================================================

# Event-level histograms (not binned by centrality)
EventHistograms: NPhotons,NJets,Vz,HiHF,Centrality

Histogram.NPhotons.Name: hNPhotons
Histogram.NPhotons.Title: Number of Photons;N_{#gamma};Entries
Histogram.NPhotons.Bins: 10
Histogram.NPhotons.XMax: 10

Histogram.NJets.Name: hNJets
Histogram.NJets.Title: Number of Jets;N_{jets};Entries
Histogram.NJets.Bins: 25
Histogram.NJets.XMax: 25

Histogram.Vz.Name: hVz
Histogram.Vz.Title: Primary Vertex z;v_{z} [cm];Entries
Histogram.Vz.Bins: 100
Histogram.Vz.XMin: -20
Histogram.Vz.XMax: 20

Histogram.HiHF.Name: hHiHF
Histogram.HiHF.Title: HF Energy Sum;#Sigma E_{T}^{HF} [GeV];Entries
Histogram.HiHF.Bins: 100
Histogram.HiHF.XMax: 7000

Histogram.Centrality.Name: hCentrality
Histogram.Centrality.Title: Centrality;hiBin;Entries
Histogram.Centrality.Bins: 200
Histogram.Centrality.XMax: 200

Histogram.JetPt.Name: hJetPt
Histogram.JetPt.Title: Jet p_{T};Leading jet p_{T} [GeV/c];Entries
Histogram.JetPt.Bins: 50
Histogram.JetPt.XMax: 200
Histogram.JetPt.LogY: 1

Histogram.JetEta.Name: hJetEta
Histogram.JetEta.Title: Jet #eta; Leading jet #eta;Entries
Histogram.JetEta.XMin: -2.5
Histogram.JetEta.XMax: 2.5

Histogram.JetPhi.Name: hJetPhi
Histogram.JetPhi.Title: Jet #phi;Leading jet #phi [rad];Entries
Histogram.JetPhi.XMin: -3.14159
Histogram.JetPhi.XMax: 3.14159

Histogram.DeltaPhi.Name: hDeltaPhi
Histogram.DeltaPhi.Title: #Delta#phi(#gamma, jet);|#Delta#phi [rad]|;Entries
Histogram.DeltaPhi.XMax: 3.14159
Histogram.DeltaPhi.MarkerStyle: kFullCircle

Histogram.Xj.Name: hXj
Histogram.Xj.Title: x_{j} = p_{T}^{jet} / E_{T}^{#gamma};x_{j};Entries
Histogram.Xj.XMax: 2.0

# =============================================================================
# PHOTON HISTOGRAMS
# =============================================================================
Histogram.PhotonEt.Name: hPhotonEt
Histogram.PhotonEt.Title: Photon E_{T};Photon E_{T} [GeV];Entries
Histogram.PhotonEt.Bins: 100
Histogram.PhotonEt.XMax: 400
Histogram.PhotonEt.LogY: 1

Histogram.PhotonEta.Name: hPhotonEta
Histogram.PhotonEta.Title: Photon #eta;Photon #eta;Entries
Histogram.PhotonEta.XMin: -2.5
Histogram.PhotonEta.XMax: 2.5

Histogram.PhotonHoverE.Name: hPhotonHoverE
Histogram.PhotonHoverE.Title: Photon H/E;Photon H/E;Entries
Histogram.PhotonHoverE.Bins: 40
Histogram.PhotonHoverE.XMax: 0.5

Histogram.PhotonSigmaIEtaIEta.Name: hPhotonSigmaIEtaIEta
Histogram.PhotonSigmaIEtaIEta.Title: Photon #sigma_{i#etai#eta};Photon #sigma_{i#etai#eta};Entries
Histogram.PhotonSigmaIEtaIEta.Bins: 40
Histogram.PhotonSigmaIEtaIEta.XMax: 0.03

Histogram.PhotonIso.Name: hPhotonIso
Histogram.PhotonIso.Title: Sum of ECAL, HCAL and Track Isolation ;#Sigma_{ECAL,HCAL,TRK} Isolation (GeV);Entries
Histogram.PhotonIso.XMin: -20
Histogram.PhotonIso.XMax: 30

Histogram.PhotonR9.Name: hPhotonR9
Histogram.PhotonR9.Title: Photon R_{9};Photon R_{9};Entries
Histogram.PhotonR9.Bins: 50
Histogram.PhotonR9.XMax: 1.0

# =============================================================================
# JET SUBSTRUCTURE HISTOGRAMS
# =============================================================================
Histogram.JetMass.Name: hJetMass
Histogram.JetMass.Title: Jet Mass;m [GeV/c^{2}];Entries
Histogram.JetMass.Bins: 20
Histogram.JetMass.XMax: 20

Histogram.DynSplit.Name: hDynSplit
Histogram.DynSplit.Title: Number of Splits;nSD;Entries
Histogram.DynSplit.Bins: 15
Histogram.DynSplit.XMax: 15
Histogram.DynSplit.MarkerStyle: kFullTriangleUp

Histogram.DynKt.Name: hDynKt
Histogram.DynKt.Title: Dynamical Groomed k_{T};k_{T} [GeV/c];Entries
Histogram.DynKt.Bins: 30
Histogram.DynKt.XMax: 15
Histogram.DynKt.LogY: 1

Histogram.DynZ.Name: hDynZ
Histogram.DynZ.Title: Dynamical Groomed z;z;Entries
Histogram.DynZ.Bins: 20
Histogram.DynZ.XMax: 0.5

Histogram.Girth.Name: hGirth
Histogram.Girth.Title: Jet Girth;Girth;Entries
Histogram.Girth.Bins: 20
Histogram.Girth.XMax: 0.2

Histogram.Thrust.Name: hThrust
Histogram.Thrust.Title: Jet Thrust;Jet Thrust;Entries
Histogram.Thrust.Bins: 20
Histogram.Thrust.XMax: 0.5

Histogram.LHA.Name: hLHA
Histogram.LHA.Title: Jet LHA;LHA;Entries
Histogram.LHA.Bins: 20
Histogram.LHA.XMax: 1.0

Histogram.PtD.Name: hPtD
Histogram.PtD.Title: Jet p_{T}D;p_{T}D;Entries
Histogram.PtD.Bins: 20
Histogram.PtD.XMax: 1.0

Histogram.JetArea.Name: hJetArea
Histogram.JetArea.Title: Jet Area;Area;Entries
Histogram.JetArea.Bins: 50
Histogram.JetArea.XMax: 1

Histogram.DynDeltaR.Name: hDynDeltaR
Histogram.DynDeltaR.Title: Jet R_{g};R_{g};Entries
Histogram.DynDeltaR.Bins: 15
Histogram.DynDeltaR.XMin: -0.05
Histogram.DynDeltaR.XMax: 0.2

Histogram.IntJetMulti.Name: hIntJetMulti
Histogram.IntJetMulti.Title: Intra Jet Multiplicity;Intra Jet Multiplicity;Entries
Histogram.IntJetMulti.Bins: 25
Histogram.IntJetMulti.XMax: 25
