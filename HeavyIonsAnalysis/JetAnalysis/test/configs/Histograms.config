# Jet phi vs eta (following h2<Xaxis>Vs<Yaxis> convention)
Histogram.JetPhiVsJetEta.Name: h2JetPhiVsJetEta
Histogram.JetPhiVsJetEta.Title: Jet #phi vs #eta;#phi;#eta
Histogram.JetPhiVsJetEta.XBins: 50
Histogram.JetPhiVsJetEta.XMin: -3.14159
Histogram.JetPhiVsJetEta.XMax: 3.14159
Histogram.JetPhiVsJetEta.YBins: 50
Histogram.JetPhiVsJetEta.YMin: -2.5
Histogram.JetPhiVsJetEta.YMax: 2.5
Histogram.JetPhiVsJetEta.PlotType: TH2D
Histogram.JetPhiVsJetEta.ColorMap: viridis
Histogram.JetPhiVsJetEta.LogZ: 0
