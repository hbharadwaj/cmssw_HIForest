# =============================================================================
# Gamma-Jet Analysis Plotting Configuration
# =============================================================================
# This file defines all plotting options, histogram specifications, and style
# settings for the gamma-jet analysis framework.
# 
# Author: Generated for CMS Heavy Ion Analysis
# Date: 2025-05-25
# =============================================================================

# =============================================================================
# HISTOGRAM DEFINITIONS
# =============================================================================

HistogramConfigFile: Histograms.config

# =============================================================================
# GENERAL PLOTTING SETTINGS
# =============================================================================

# Enable/disable plotting functionality
# EnablePlotting: 1
# SavePlots: 1
PlotFormats: png,root
#pdf

# CMS Style and Labeling
# UseCMSStyle: 1
CMSLabel: Preliminary
CMSEnergyText: 5.36 TeV pp
CMSLuminosity: 455.7 pb^{-1}
CMSExtraText: 

# Color scheme selection (petroff6, petroff10, viridis)
ColorScheme: petroff6
UseColorBlind: 1

# Canvas settings
Canvas.Width: 800
Canvas.Height: 600
Canvas.LeftMargin: 0.15
Canvas.RightMargin: 0.05
Canvas.TopMargin: 0.08
Canvas.BottomMargin: 0.12

# =============================================================================
# SELECTION CRITERIA (for automatic selection text generation)
# =============================================================================

# Photon selection criteria
SelectionPhotonPtMin: 80
# SelectionPhotonPtMax: 200
SelectionPhotonEtaMax: 1.44

# Jet selection criteria
SelectionJetPtMin: 40
SelectionJetEtaMax: 2.0

# Angular correlation criteria
SelectionDeltaPhiMin: 2#pi/3

# Alternative: Use custom selection text (uncomment to override automatic generation)
SelectionText.Custom: p_{T}^{#gamma}>80 GeV, |#eta^{#gamma}| < 1.44\\np_{T}^{jet} > 40 GeV\\n#Delta#phi > 0.1 to remove photons inside jets
SelectionText.Position: top-left
SelectionText.TextSize: 0.04
SelectionText.Color: 1

# =============================================================================
# 2D HISTOGRAMS AND PROFILES
# =============================================================================

# Dynamical splitting vs pT
# Histogram.DynSplitVsPt.Name: h2DynSplitVsPt
# Histogram.DynSplitVsPt.Title: Dynamical Groomed Splitting vs p_{T};p_{T} [GeV/c];#sqrt{z#theta} [GeV/c]
# Histogram.DynSplitVsPt.XBins: 15
# Histogram.DynSplitVsPt.XMin: 0
# Histogram.DynSplitVsPt.XMax: 15
# Histogram.DynSplitVsPt.YBins: 50
# Histogram.DynSplitVsPt.YMin: 0
# Histogram.DynSplitVsPt.YMax: 400
# Histogram.DynSplitVsPt.PlotType: TH2D
# Histogram.DynSplitVsPt.ColorMap: viridis
# Histogram.DynSplitVsPt.LogZ: 0

# Profile version
# Histogram.ProfileDynSplitVsPt.Name: pDynSplitVsPt
# Histogram.ProfileDynSplitVsPt.Title: Dynamical Groomed Splitting vs p_{T};p_{T} [GeV/c];<#sqrt{z#theta}> [GeV/c]
# Histogram.ProfileDynSplitVsPt.XBins: 15
# Histogram.ProfileDynSplitVsPt.XMin: 0
# Histogram.ProfileDynSplitVsPt.XMax: 15
# Histogram.ProfileDynSplitVsPt.YBins: 50
# Histogram.ProfileDynSplitVsPt.YMin: 0
# Histogram.ProfileDynSplitVsPt.YMax: 50
# Histogram.ProfileDynSplitVsPt.PlotType: TProfile
# Histogram.ProfileDynSplitVsPt.Color: auto
# Histogram.ProfileDynSplitVsPt.LineWidth: 2
# Histogram.ProfileDynSplitVsPt.MarkerStyle: kFullCircle
# Histogram.ProfileDynSplitVsPt.MarkerSize: 0.8
# Histogram.ProfileDynSplitVsPt.DrawOption: E1

# =============================================================================
# JET COLLECTION SETTINGS
# =============================================================================

# Jet collection specific settings (override default colors/styles)
# JetCollection.ak4PFJets.Color: #5790fc
# JetCollection.ak4PFJets.LineStyle: 1
# JetCollection.ak4PFJets.MarkerStyle: 20

# JetCollection.ak4CaloJets.Color: #f89c20
# JetCollection.ak4CaloJets.LineStyle: 2
# JetCollection.ak4CaloJets.MarkerStyle: 21

# JetCollection.ak3PFJets.Color: #e42536
# JetCollection.ak3PFJets.LineStyle: 3
# JetCollection.ak3PFJets.MarkerStyle: 22

# =============================================================================
# OVERLAY PLOTS CONFIGURATION
# =============================================================================

# Define which plots should be overlaid across centrality bins
OverlayPlots: JetPt,JetEta,DeltaPhi,JetXj,JetDynSplit,JetMass,JetDynDeltaR,IntJetMulti

# Enable different types of overlays
OverlayByCentrality: 0
OverlayByJetCollection: 1

# Which jet collections to include in overlays (comma-separated)
# Options: AK2Z1,AK4Z2,AK6Z3,AK8Z4,AK8Z5 or "all"
OverlayJetCollections: AK2Z1,AK2Z2,AK2Z3

# Which centrality bins to include in overlays (comma-separated) 
# Format: cent0to60,cent60to180 or "all"
# OverlayCentralityBins: cent0to60,cent60to180

# Overlay plot settings
Overlay.DrawLegend: 1
Overlay.LegendPosition: 0.65,0.65,0.9,0.9
Overlay.LegendTextSize: 0.03
Overlay.LegendFillStyle: 0
Overlay.LegendBorderSize: 0

# =============================================================================
# ADVANCED PLOTTING FEATURES
# =============================================================================

# Ratio plots for overlays (unified system)
CreateRatioPlots: 1
Ratio.DivideBy: first
Ratio.Min: 0.5
Ratio.Max: 1.5
Ratio.YTitle: Ratio
Ratio.UpperPadHeight: 0.7
Ratio.LowerPadHeight: 0.3

# Global axis and grid settings (defaults, individual histograms can override)
LogY: 0
LogX: 0
DrawGrid: 0

# Advanced legend settings
Legend.AutoPosition: 1
Legend.AvoidOverlap: 1
Legend.PreferredPositions: top-right,top-left,bottom-right
Overlay.LegendColumns: 1

# Text size standardization (for consistent appearance across all plot types)
Axis.TitleSize: 0.05
Axis.LabelSize: 0.04
# For ratio plots (multi-pad layouts)
Axis.TitleOffsetX: 3.5
Axis.TitleOffsetY: 1.4
# For single plots 
Axis.TitleOffsetX.Single: 1.2
Axis.TitleOffsetY.Single: 1.0
Marker.Size: 0.8

# Content-aware positioning controls
SelectionText.AvoidData: 1
SelectionText.AvoidLegend: 1
SelectionText.ContentWeight: 0.7
Legend.AvoidData: 1
Legend.AvoidText: 1
Legend.ContentWeight: 0.8

# Text size standardization (for consistent appearance across all plot types)
Axis.TitleSize: 0.05
Axis.LabelSize: 0.04
Axis.TitleOffsetX: 3.5
Axis.TitleOffsetY: 1.4
Marker.Size: 0.8

# =============================================================================
# OUTPUT CONTROL
# =============================================================================

# Which plots to generate (can be used to disable specific plots)
EnabledPlots.JetPt: 1
EnabledPlots.JetEta: 1
EnabledPlots.JetPhi: 1
EnabledPlots.DeltaPhi: 1
EnabledPlots.Xj: 1
EnabledPlots.PhotonEt: 1
EnabledPlots.PhotonEta: 1
EnabledPlots.JetMass: 1
EnabledPlots.DynSplit: 1
EnabledPlots.DynKt: 1
EnabledPlots.DynZ: 1
EnabledPlots.Girth: 1
EnabledPlots.Thrust: 1
EnabledPlots.LHA: 1
EnabledPlots.PtD: 1
EnabledPlots.JetPtVsEta: 1
EnabledPlots.DynSplitVsPt: 1
EnabledPlots.JetMassVsPt: 1

# Enable overlay plots
EnabledPlots.Overlays: 1

# Enable event-level plots
EnabledPlots.EventLevel: 1

# =============================================================================
# ADVANCED PLOTTING OPTIONS
# =============================================================================

# Statistical boxes
ShowStatBox: 0
StatBoxPosition: 0.7,0.7,0.9,0.9

# Grid lines
ShowGridX: 0
ShowGridY: 0

# Normalization options
NormalizeHistograms: 0
NormalizationStyle: integral

# Axis range auto-adjustment
AutoAdjustYRange: 1
YRangeMarginTop: 0.1
YRangeMarginBottom: 0.0

# Error bars
ShowErrorBars: 1
ErrorBarStyle: 0

# =============================================================================
# ROOT FILE STRUCTURE SETTINGS
# =============================================================================

# Root file structure (nested directories)
UseNestedStructure: 1
JetDirectories: AK2Z1,AK2Z2,AK2Z3,AK3Z1,AK3Z2,AK3Z3,AK4Z1,AK4Z2,AK4Z3,AK5Z1,AK5Z2,AK5Z3,AK6Z1,AK6Z2,AK6Z3,AK8Z1,AK8Z2,AK8Z3
# CentralityBins: 0,60,180
DefaultJetDir: AK2Z2
DefaultCentralityBin: cent0to60

# Histogram location within nested structure (empty for direct access)
HistogramSubdir: 

# =============================================================================
# HISTOGRAM NORMALIZATION SETTINGS (unified ratio system used above)
# =============================================================================

# Enable/disable normalization for overlay plots (default: enabled)
Overlay.Normalize: 1

# Normalization methods (simplified):
# - area: Normalize to unit area (integral = 1) - DEFAULT
# - density: Normalize to unit area and divide by bin width (proper density)
# - none: No normalization
Overlay.NormalizationMethod: area

# Display options for normalization
Overlay.ShowNormalizationInLegend: 0
Overlay.ShowNormalizationFactors: 0
Overlay.AddNormalizationToFilename: 0

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
