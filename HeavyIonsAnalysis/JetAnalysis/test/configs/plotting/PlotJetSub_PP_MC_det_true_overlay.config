# =============================================================================
# CMS Gamma-Jet Analysis Configuration with Data-MC Comparison Support
# =============================================================================
# Enhanced configuration for plotting gamma-jet analysis results
# Supports both single ROOT file plotting and Data-MC comparisons
# Consistent with PlotJetSub_2023_PbPb_Data.config and PlotJetSub_2023_PbPb_MC.config
# 
# Author: Generated for CMS Heavy Ion Analysis
# Date: 2025-05-26
# =============================================================================

# =============================================================================
# INPUT FILES AND CONFIGS (multi-file overlay specification)
# =============================================================================

# Input files for multi-file overlays
# Format: InputFile.<label>: <root_file_path>:<config_file_path>:<display_label>
# InputFile.Detector: /eos/user/b/bharikri/www/Run3GammaJet/2025_08_29/skim/phoEt_100/2024_PbPb/2025_08_29_PbPb_2024_QCDPhoton_jetpT40_xJ_reweighted_output_combined.root:/eos/user/b/bharikri/lxplus_private/run3_gamma_jet/CMSSW_13_2_13/src/HeavyIonsAnalysis/JetAnalysis/test/configs/plotting/PlotJetSub_2023_PbPb_MC.config:MC Reconstructed
# InputFile.MCTruth:  /eos/user/b/bharikri/www/Run3GammaJet/2025_08_29/skim/phoEt_100/2024_PbPb/2025_08_29_PbPb_2024_QCDPhoton_jetpT40_xJ_reweighted_output_combined.root:/eos/user/b/bharikri/lxplus_private/run3_gamma_jet/CMSSW_13_2_13/src/HeavyIonsAnalysis/JetAnalysis/test/configs/plotting/PlotJetSub_2023_PbPb_MC.config:MC Truth

InputFile.Detector: /eos/user/b/bharikri/www/Run3GammaJet/2025_08_29/skim/phoEt_100/2024_PP/2025_08_29_PP_2024_QCDPhoton30_jetpT40_output_combined.root:/eos/user/b/bharikri/lxplus_private/run3_gamma_jet/CMSSW_13_2_13/src/HeavyIonsAnalysis/JetAnalysis/test/configs/plotting/PlotJetSub_2023_PbPb_MC.config:MC Reconstructed
InputFile.MCTruth:  /eos/user/b/bharikri/www/Run3GammaJet/2025_08_29/skim/phoEt_100/2024_PP/2025_08_29_PP_2024_QCDPhoton30_jetpT40_output_combined.root:/eos/user/b/bharikri/lxplus_private/run3_gamma_jet/CMSSW_13_2_13/src/HeavyIonsAnalysis/JetAnalysis/test/configs/plotting/PlotJetSub_2023_PbPb_MC.config:MC Truth

# =============================================================================
# GENERAL PLOTTING SETTINGS
# =============================================================================

# Enable/disable plotting functionality
# EnablePlotting: 1
# SavePlots: 1
PlotFormats: png,root
#pdf

# ROOT file structure
UseNestedStructure: 1

# CMS Style and Labeling
UseCMSStyle: 1
CMSLabel: Preliminary 
CMSEnergyText: 5.36 TeV 
CMSLuminosity: pp 455.7 pb^{-1}
# 1.72 nb^{-1} 
CMSExtraText: Simulation

# Color scheme selection (petroff6, petroff10, viridis, default)
ColorScheme: petroff6
UseColorBlind: 0

# Canvas settings
Canvas.Width: 800
Canvas.Height: 600
Canvas.LeftMargin: 0.15
Canvas.RightMargin: 0.05
Canvas.TopMargin: 0.08
Canvas.BottomMargin: 0.12

# =============================================================================
# HISTOGRAM DEFINITIONS - REMOVED
# =============================================================================
# 
# NOTE: Histogram definitions are now sourced from individual PlotJetSub configs
# specified in the InputFile entries above. Each input file has its own config
# which contains the histogram definitions appropriate for that file.
# 
# This ensures no config mismatches and allows different histogram definitions
# per file (e.g., MC-only histograms vs Data-only histograms).
#

# =============================================================================
# JETS AND CENTRALITY CONFIGURATION
# =============================================================================

# Jet Collections (will be read from individual PlotJetSub configs)
# JetDirectories: AK2Z1,AK2Z2,AK2Z3,AK3Z1,AK3Z2,AK3Z3,AK4Z1,AK4Z2,AK4Z3,AK5Z1,AK5Z2,AK5Z3,AK6Z1,AK6Z2,AK6Z3,AK8Z1,AK8Z2,AK8Z3

# Centrality Bins (will be read from individual PlotJetSub configs)
# CentralityBins: 0,60,180

# =============================================================================
# SINGLE-FILE OVERLAY CONTROL
# =============================================================================

# Enable single-file overlays (within same file)
#OverlayByCentrality: 1        # Overlay different jet collections within same centrality
#OverlayByJetCollection: 1     # Overlay different centralities within same jet collection

# Which jet collections to include in single-file overlays
OverlayJetCollections: AK2Z1,AK2Z2,AK2Z3

# Which centrality bins to include in single-file overlays
OverlayCentralityBins: inclusive


# =============================================================================
# EXPLICIT OVERLAY SPECIFICATIONS
# =============================================================================

# Custom overlays with specific paths and output locations
# Format: ExplicitOverlay.<name>: <file1_path>:<file2_path>
# ExplicitOverlay.<name>.Path: <custom_output_path>
# If no Path specified, uses "overlays/Explicit" by default

# Example explicit overlays:
# ExplicitOverlay.DataMC_JetPt_Central: cent0to60/AK2Z2/hJetPt:cent0to60/AK2Z2/hRefPt
# ExplicitOverlay.DataMC_JetPt_Central.Path: datamc_comparison/jetpt_central
# ExplicitOverlay.CrossCent_JetPt_AK2Z2: cent0to60/AK2Z2/hJetPt:cent60to180/AK2Z2/hJetPt
# ExplicitOverlay.CrossCent_JetPt_AK2Z2.Path: cross_centrality/jetpt_ak2z2

ExplicitOverlay.Det_True_JetPt_Central: inclusive/AK2Z2/hJetPt:inclusive/AK2Z2/hRefPt
ExplicitOverlay.Det_True_JetPt_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_xJ_Central: inclusive/AK2Z2/hJetXj:inclusive/AK2Z2/hRefXj
ExplicitOverlay.Det_True_xJ_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetGirth_Central: inclusive/AK2Z2/hJetGirth:inclusive/AK2Z2/hRefGirth
ExplicitOverlay.Det_True_JetGirth_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetRg_Central: inclusive/AK2Z2/hJetDynDeltaR:inclusive/AK2Z2/hRefDynDeltaR
ExplicitOverlay.Det_True_JetRg_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetMass_Central: inclusive/AK2Z2/hJetMass:inclusive/AK2Z2/hRefMass
ExplicitOverlay.Det_True_JetMass_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetThrust_Central: inclusive/AK2Z2/hJetThrust:inclusive/AK2Z2/hRefThrust
ExplicitOverlay.Det_True_JetThrust_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetLHA_Central: inclusive/AK2Z2/hJetLHA:inclusive/AK2Z2/hRefLHA
ExplicitOverlay.Det_True_JetLHA_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetPtD_Central: inclusive/AK2Z2/hJetPtD:inclusive/AK2Z2/hRefPtD
ExplicitOverlay.Det_True_JetPtD_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetTauForm_Central: inclusive/AK2Z2/hJetTauForm:inclusive/AK2Z2/hRefTauForm
ExplicitOverlay.Det_True_JetTauForm_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetDynSplit_Central: inclusive/AK2Z2/hJetDynSplit:inclusive/AK2Z2/hRefDynSplit
ExplicitOverlay.Det_True_JetDynSplit_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetDynKt_Central: inclusive/AK2Z2/hJetDynKt:inclusive/AK2Z2/hRefDynKt
ExplicitOverlay.Det_True_JetDynKt_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_JetDynZ_Central: inclusive/AK2Z2/hJetDynZ:inclusive/AK2Z2/hRefDynZ
ExplicitOverlay.Det_True_JetDynZ_Central.Path: overlays/inclusive/AK2Z2

ExplicitOverlay.Det_True_IntJetMulti_Central: inclusive/AK2Z2/hIntJetMulti:inclusive/AK2Z2/hRefIntJetMulti
ExplicitOverlay.Det_True_IntJetMulti_Central.Path: overlays/inclusive/AK2Z2

# =============================================================================
# ADVANCED PLOTTING FEATURES
# =============================================================================

# Ratio plots for overlays
CreateRatioPlots: 0
Ratio.DivideBy: first
Ratio.Min: 0.5
Ratio.Max: 1.5
Ratio.YTitle: MC/Data
Ratio.AutoRange: 0
Ratio.UpperPadHeight: 0.7
Ratio.LowerPadHeight: 0.3

# Global axis and grid settings (defaults, can be overridden per histogram)
LogY: 0
LogX: 0
DrawGrid: 0
# XMin: 20
# XMax: 80
# YMin: 0
# YMax: 500

# Advanced legend settings
Legend.AutoPosition: 1
Legend.AvoidOverlap: 1
Legend.PreferredPositions: top-right,top-left,bottom-right
Overlay.LegendColumns: 1

# Text size standardization (for consistent appearance across all plot types)
Axis.TitleSize: 0.05
Axis.LabelSize: 0.04
# For ratio plots (multi-pad layouts)
Axis.TitleOffsetX: 3.5
Axis.TitleOffsetY: 1.4
# For single plots 
Axis.TitleOffsetX.Single: 1.2
Axis.TitleOffsetY.Single: 1.0
Marker.Size: 1.2

# =============================================================================
# DATA-MC COMPARISON SETTINGS
# =============================================================================

# Data-MC Comparison Settings
DataMC.DataLabel: Data
DataMC.MCLabel: PYTHIA8
DataMC.DataColor: 1
DataMC.MCColor: 2
DataMC.DataMarkerStyle: 20
DataMC.MCMarkerStyle: 21
DataMC.DataMarkerSize: 1.5
DataMC.MCMarkerSize: 1.5
DataMC.DataLineWidth: 2
DataMC.MCLineWidth: 2

# Ratio Plot Settings (unified with new system)
# Note: CreateRatioPlots above enables ratio plots
# These settings provide DataMC-specific styling
DataMC.RatioTitle: Data/MC
DataMC.RatioYMin: 0.5
DataMC.RatioYMax: 1.5
DataMC.RatioColor: 1
DataMC.RatioMarkerStyle: 20
DataMC.RatioMarkerSize: 1.1

# Canvas Settings for Data-MC (override global settings)
DataMC.Canvas.Width: 800
DataMC.Canvas.Height: 800
DataMC.UpperPadHeight: 0.7
DataMC.LowerPadHeight: 0.3

# Legend Settings
DataMC.LegendX1: 0.65
DataMC.LegendY1: 0.75
DataMC.LegendX2: 0.85
DataMC.LegendY2: 0.85

# Normalization Option (0=absolute, 1=normalized comparison)
DataMC.Normalize: 1

# =============================================================================
# OVERLAY SPECIFICATIONS
# =============================================================================

# Implicit overlays (histograms with same name/path across files)
# Format Options:
#   1. Specific: ImplicitOverlay.<name>: <histogram_key>:<jet_dir>:<cent_bin>
#   2. Wildcard: ImplicitOverlay.<name>: <histogram_key>:<jet_pattern>:<cent_pattern>
# 
# Wildcard patterns:
#   * = match all
#   AK4* = match all starting with AK4 (e.g., AK4Z1, AK4Z2, AK4Z3)
#   *Z2 = match all ending with Z2 (e.g., AK2Z2, AK4Z2, AK6Z2)

# TEST: Only one overlay for a known-to-exist histogram in both Data and MC
# ImplicitOverlay.JetPt_AK2Z2_Central: hJetPt:AK2Z2:inclusive

# All other overlays commented for minimal test
# ImplicitOverlay.JetPt_AllJets_Central: hJetPt:*:inclusive
# ImplicitOverlay.JetPt_AllJets_Peripheral: hJetPt:*:cent30to90
# ImplicitOverlay.JetEta_AllJets_Central: hJetEta:*:inclusive
# ImplicitOverlay.JetEta_AllJets_Peripheral: hJetEta:*:cent30to90
# ImplicitOverlay.DeltaPhi_AllJets_Central: hDeltaPhi:*:inclusive
# ImplicitOverlay.DeltaPhi_AllJets_Peripheral: hDeltaPhi:*:cent30to90
# ImplicitOverlay.Xj_AllJets_Central: hJetXj:*:inclusive
# ImplicitOverlay.Xj_AllJets_Peripheral: hJetXj:*:cent30to90
# ImplicitOverlay.JetMass_AllJets_Central: hJetMass:*:inclusive
# ImplicitOverlay.JetMass_AllJets_Peripheral: hJetMass:*:cent30to90
# ImplicitOverlay.DynSplit_AllJets_Central: hDynSplit:*:inclusive
# ImplicitOverlay.DynSplit_AllJets_Peripheral: hDynSplit:*:cent30to90
# ImplicitOverlay.DynDeltaR_AllJets_Central: hDynDeltaR:*:inclusive
# ImplicitOverlay.DynDeltaR_AllJets_Peripheral: hDynDeltaR:*:cent30to90
# ImplicitOverlay.IntJetMulti_AllJets_Central: hIntJetMulti:*:inclusive
# ImplicitOverlay.IntJetMulti_AllJets_Peripheral: hIntJetMulti:*:cent30to90
# ImplicitOverlay.PhotonEt_Central: hPhotonEt:*:inclusive
# ImplicitOverlay.PhotonEt_Peripheral: hPhotonEt:*:cent30to90
# ImplicitOverlay.PhotonEta_Central: hPhotonEta:*:inclusive
# ImplicitOverlay.PhotonEta_Peripheral: hPhotonEta:*:cent30to90

# You can add more overlays for other histograms as needed, e.g. Girth, Thrust, DynKt, DynZ, etc.
# Example:
# ImplicitOverlay.Girth_AllJets_Central: Girth:*:inclusive
# ImplicitOverlay.Girth_AllJets_Peripheral: Girth:*:cent30to90

# Explicit overlays (histograms with different names/paths across files)
# Format: ExplicitOverlay.<name>: <file1_label>:<hist_key>:<jet_dir>:<cent_bin>,<file2_label>:<hist_key>:<jet_dir>:<cent_bin>
# Example: ExplicitOverlay.MCvsReco: MC:MCJetPt:AK4Z2:inclusive,Data:RecoJetPt:AK4Z2:inclusive

# =============================================================================
# OVERLAY AND OUTPUT SETTINGS
# =============================================================================

# Legacy overlay settings (for backward compatibility with single-file mode)
# OverlayPlots: JetPt,PhotonEt,JetPt,JetEta,JetPhi,JetMass,JetGirth,JetThrust,JetLHA,JetPtD,DeltaPhi,JetXj,JetDynSplit,JetDynKt,JetDynZ,JetDynDeltaR,IntJetMulti
# OverlayByCentrality: 1
# OverlayByJetCollection: 1

# Output Directory Structure
CreateSubdirectories: 1

# =============================================================================
# SELECTION CRITERIA (for automatic selection text generation)
# =============================================================================

# Photon selection criteria (consistent with Data/MC configs)
SelectionPhotonPtMin: 100
# SelectionPhotonPtMax: 200
SelectionPhotonEtaMax: 1.44

# Jet selection criteria (consistent with Data/MC configs)
SelectionJetPtMin: 40
SelectionJetEtaMax: 2.0

# Angular correlation criteria (consistent with Data/MC configs)
SelectionDeltaPhiMin: 2#pi/3

# Alternative: Use custom selection text (uncomment to override automatic generation)
SelectionText.Custom: p_{T}^{#gamma}>100 GeV, |#eta^{#gamma}| < 1.44 \\n#Delta#phi^{#gamma, jet} > 2 #pi/3 \\np_{T}^{jet} > 40 GeV
 
# "top-right": (0.65, 0.65, 0.89, 0.89),
# "top-left": (0.15, 0.65, 0.39, 0.89),
# "bottom-right": (0.65, 0.15, 0.89, 0.39),
# "bottom-left": (0.15, 0.15, 0.39, 0.39),
# "center-right": (0.65, 0.40, 0.89, 0.64),
# "center-left": (0.15, 0.40, 0.39, 0.64)

SelectionText.Position: center-right

# Use explicit coordinates instead of named position for precise control
# SelectionText.X: 0.5
# SelectionText.Y: 0.5


SelectionText.TextSize: 0.045
SelectionText.LineSpacing: 0.07
SelectionText.Color: 1

# Content-aware positioning controls
SelectionText.CheckBoundaries: 1
SelectionText.AvoidData: 1
SelectionText.AvoidLegend: 1
SelectionText.ContentWeight: 0.7
SelectionText.ScoreThreshold: 0.08


# =============================================================================
# TEXT AND LEGEND POSITIONING
# =============================================================================

# Remove stat boxes globally
RemoveStatBox: 1

# CMS Label positioning (NDC coordinates)
CMS.Position.X: 0.18
CMS.Position.Y: 0.92
CMS.TextSize: 0.042

# Selection text positioning and formatting (LEGACY - not used when X,Y specified above)
# SelectionText.Position.X: 0.18
# SelectionText.Position.Y: 0.82  
# SelectionText.TextSize: 0.032
# SelectionText.MaxLineLength: 60
# SelectionText.LineSpacing: 0.06
# SelectionText.CheckBoundaries: 1

# Legend positioning for overlays
Overlay.LegendPosition: 0.65,0.65,0.9,0.9
Overlay.LegendBorderSize: 0
Overlay.LegendFillStyle: 0
Overlay.LegendTextSize: 0.045
Overlay.LegendColumns: 1
Overlay.LegendTransparent: 1

# Advanced positioning with collision detection
Legend.CollisionDetection: 1
Legend.PreferredPosition: top_right
Legend.AlternativePositions: top_left,bottom_right,bottom_left

# Content-aware legend positioning controls
Legend.AvoidData: 1
Legend.AvoidText: 1
Legend.ContentWeight: 0.8

# Text positioning for 1D and 2D plots
Plot1D.SelectionText.Position: auto  # or manual coordinates
Plot2D.SelectionText.Position: 0.20,0.30

# =============================================================================
# CANVAS AND STYLE SETTINGS
# =============================================================================

# Enhanced canvas margins for better text placement
CanvasMarginLeft: 0.15
CanvasMarginRight: 0.05
CanvasMarginTop: 0.08
CanvasMarginBottom: 0.12

# Automatic margin adjustment for long text
AutoAdjustMargins: 1

# Color scheme options
Colors.Data: 1
Colors.MC: 2,4,6,8
Colors.Systematic: 15

# =============================================================================
# HISTOGRAM NORMALIZATION SETTINGS
# =============================================================================

# Enable/disable normalization for overlay plots (default: enabled)
Overlay.Normalize: 1

# Normalization methods (simplified):
# - area: Normalize to unit area (integral = 1) - DEFAULT
# - density: Normalize to unit area and divide by bin width (proper density)
# - none: No normalization
Overlay.NormalizationMethod: area

# Display options for normalization
Overlay.ShowNormalizationInLegend: 0
Overlay.ShowNormalizationFactors: 0
Overlay.AddNormalizationToFilename: 0

# PlotType patterns for ImplicitOverlay names
# PlotType.JetPt_AK2Z2_Central: inclusive/jet_analysis/pt_distributions
# PlotType.JetPt_AllJets_Central: inclusive/jet_analysis/pt_distributions
# PlotType.JetPt_AllJets_Peripheral: cent30to90/jet_analysis/pt_distributions
# PlotType.JetEta_AllJets_Central: inclusive/jet_analysis/eta_distributions
# PlotType.JetEta_AllJets_Peripheral: cent30to90/jet_analysis/eta_distributions
# PlotType.DeltaPhi_AllJets_Central: inclusive/correlations/deltaphi
# PlotType.DeltaPhi_AllJets_Peripheral: cent30to90/correlations/deltaphi
# PlotType.Xj_AllJets_Central: inclusive/correlations/momentum_balance
# PlotType.Xj_AllJets_Peripheral: cent30to90/correlations/momentum_balance
# PlotType.JetMass_AllJets_Central: inclusive/jet_analysis/mass_distributions
# PlotType.JetMass_AllJets_Peripheral: cent30to90/jet_analysis/mass_distributions
# PlotType.DynSplit_AllJets_Central: inclusive/substructure/dynamical_grooming
# PlotType.DynSplit_AllJets_Peripheral: cent30to90/substructure/dynamical_grooming
# PlotType.DynDeltaR_AllJets_Central: inclusive/substructure/dynamical_grooming
# PlotType.DynDeltaR_AllJets_Peripheral: cent30to90/substructure/dynamical_grooming
# PlotType.IntJetMulti_AllJets_Central: inclusive/substructure/multiplicities
# PlotType.IntJetMulti_AllJets_Peripheral: cent30to90/substructure/multiplicities
# PlotType.PhotonEt_Central: inclusive/photon_analysis/energy_distributions
# PlotType.PhotonEt_Peripheral: cent30to90/photon_analysis/energy_distributions
# PlotType.PhotonEta_Central: inclusive/photon_analysis/eta_distributions
# PlotType.PhotonEta_Peripheral: cent30to90/photon_analysis/eta_distributions
