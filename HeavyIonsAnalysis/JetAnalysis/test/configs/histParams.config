# Global Style Settings
Global.CMS_Style true
Global.Font_Type 42
Global.Font_Size 0.035
Global.Legend_TextSize 0.025

# Binning Definitions
CentralityBins 0,30,60,180  # Standard binning
EtaBins -1.44,0,1.44       # Barrel regions

# 1. Event Level Distributions
# Basic validation histograms
Hist.HiHF.title "HF Energy Sum"
Hist.HiHF.bins 100
Hist.HiHF.range 0 7000
Hist.HiHF.centrality_bins 0,30,60,180

Hist.Rho.title "Event Rho"
Hist.Rho.bins 50
Hist.Rho.range 0 400

# 2. Photon Properties
# Single histograms with multiple centrality/eta bins
Hist.PhotonEt.title "Photon E_{T}"
Hist.PhotonEt.bins 50
Hist.PhotonEt.range 30 500
Hist.PhotonEt.y_log true
Hist.PhotonEt.centrality_bins 0,30,60,180
Hist.PhotonEt.eta_bins -1.44,0,1.44

Hist.PhotonHoverE.title "Photon H/E"
Hist.PhotonHoverE.bins 50
Hist.PhotonHoverE.range 0 0.2
Hist.PhotonHoverE.centrality_bins 0,30,60,180

# 3. Jet Properties
Hist.JetPt.title "Jet p_{T}"
Hist.JetPt.bins 50
Hist.JetPt.range 30 500
Hist.JetPt.centrality_bins 0,30,60,180

# 4. Correlation Plots
# Multi-histogram overlays
Compare.DeltaPhi.histograms DeltaPhi_All,DeltaPhi_Lead
Compare.DeltaPhi.labels "All Jets","Leading Jet"  
Compare.DeltaPhi.colors 1,632
Compare.DeltaPhi.markers 20,25
Compare.DeltaPhi.centrality_bins 0,30,60,180

# 5. 2D Distributions
Hist2D.JetEtaPhi.x_title "Jet #eta"
Hist2D.JetEtaPhi.y_title "Jet #phi"
Hist2D.JetEtaPhi.x_bins 50
Hist2D.JetEtaPhi.y_bins 50
Hist2D.JetEtaPhi.x_range -2.5 2.5
Hist2D.JetEtaPhi.y_range -3.142 3.142
Hist2D.JetEtaPhi.draw_opt colz
Hist2D.JetEtaPhi.centrality_bins 0,30,60,180

# 6. Validation N-1 Plots
Validate.PhotonID.histograms HoverE,SigmaIEtaIEta,Isolation
Validate.PhotonID.layout 1x3
Validate.PhotonID.centrality_bins 0,30,60,180

# 7. Response/Resolution
Hist2D.PtResponse.x_title "p_{T}^{gen}"
Hist2D.PtResponse.y_title "p_{T}^{reco}/p_{T}^{gen}"
Hist2D.PtResponse.x_bins 50
Hist2D.PtResponse.y_bins 50
Hist2D.PtResponse.x_range 30 500
Hist2D.PtResponse.y_range 0.5 1.5
