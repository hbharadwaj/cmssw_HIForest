# System Configuration 
System 2023_PbPb
DataType MC
InputDir /eos/cms/store/group/phys_heavyions/bharikri/Run3GammaJet/2023_PbPb/MC/
OutputDir /eos/user/b/bharikri/www/Run3GammaJet/2025_05_21/2023_PbPb/MC/test/
OutputPrefix test_photon_only

# Event Selection - Minimal cuts
HiHFCutMin 0
HiHFCutMax 10000  # More inclusive
VzCut 15.0

# Photon Selection - Minimal cuts
PhotonEtMin 20.0  # Lower threshold for more statistics
PhotonEtaMax 2.1  # Wider acceptance
PhotonHoverEMax 0.2  # Looser cut
PhotonSigmaIEtaIEtaMax 0.02  # Looser cut
PhotonIsoMax 5.0  # Looser cut
PhotonR9Min 0.5  # Looser cut

# Centrality Bins - Simple binning
CentralityBins 0 100
