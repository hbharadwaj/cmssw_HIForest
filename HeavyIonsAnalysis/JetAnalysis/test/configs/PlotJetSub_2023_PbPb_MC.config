# =============================================================================
# Gamma-Jet Analysis Plotting Configuration
# =============================================================================
# This file defines all plotting options, histogram specifications, and style
# settings for the gamma-jet analysis framework.
# 
# Author: Generated for CMS Heavy Ion Analysis
# Date: 2025-05-25
# =============================================================================

# =============================================================================
# HISTOGRAM DEFINITIONS
# =============================================================================

HistogramConfigFile: Histograms.config

# =============================================================================
# GENERAL PLOTTING SETTINGS
# =============================================================================

# Enable/disable plotting functionality
# EnablePlotting: 1
# SavePlots: 1
PlotFormats: png,root


# CMS Style and Labeling
# UseCMSStyle: 1
CMSLabel: Preliminary 
CMSEnergyText: 5.36 TeV PbPb
CMSLuminosity: 1.72 nb^{-1}
CMSExtraText: Simulation

# Color scheme selection (petroff6, petroff10, viridis)
ColorScheme: petroff6
UseColorBlind: 1

# Canvas settings
CanvasWidth: 800
CanvasHeight: 600
CanvasMarginLeft: 0.15
CanvasMarginRight: 0.05
CanvasMarginTop: 0.08
CanvasMarginBottom: 0.12

# =============================================================================
# SELECTION CRITERIA (for automatic selection text generation)
# =============================================================================

# Photon selection criteria
SelectionPhotonPtMin: 80
# SelectionPhotonPtMax: 200
SelectionPhotonEtaMax: 1.44

# Jet selection criteria
SelectionJetPtMin: 40
SelectionJetEtaMax: 2.0

# Angular correlation criteria
SelectionDeltaPhiMin: 2#pi/3

# Alternative: Use custom selection text (uncomment to override automatic generation)
SelectionText: Gen-Matched Photon, p_{T}^{#gamma}>80 GeV, |#eta^{#gamma}| < 1.44, p_{T}^{jet} > 40 GeV, #Delta#phi > 0.1 to remove photons inside jets, Should be handled with PhoIso

# =============================================================================
# MC Truth HISTOGRAMS
# =============================================================================

# Photon histograms

Histogram.PhotonGenMatch.Name: hPhotonGenMatch
Histogram.PhotonGenMatch.Title: Photon Gen Match Index;Photon Gen Match Index;Entries
Histogram.PhotonGenMatch.Bins: 10
Histogram.PhotonGenMatch.XMax: 10

Histogram.MCPhotonEt.Name: hMCPhotonEt
Histogram.MCPhotonEt.Title: MC matched Photon E_{T};MC E_{T} [GeV];Entries
Histogram.MCPhotonEt.Bins: 100
Histogram.MCPhotonEt.XMax: 400
Histogram.MCPhotonEt.LogY: 1

Histogram.MCPhotonEta.Name: hMCPhotonEta
Histogram.MCPhotonEta.Title: MC matched Photon #eta;MC #eta;Entries
Histogram.MCPhotonEta.Bins: 50
Histogram.MCPhotonEta.XMin: -2.5
Histogram.MCPhotonEta.XMax: 2.5
Histogram.MCPhotonEta.MarkerStyle: kFullSquare

Histogram.MCPhotonPhi.Name: hMCPhotonPhi
Histogram.MCPhotonPhi.Title: MC matched Photon #phi;MC #phi;Entries
Histogram.MCPhotonPhi.Bins: 50
Histogram.MCPhotonPhi.XMin: -3.14159
Histogram.MCPhotonPhi.XMax: 3.14159

Histogram.MCPhotonPID.Name: hMCPhotonPID
Histogram.MCPhotonPID.Title: MC matched Photon PID;MC Photon PID;Entries
Histogram.MCPhotonPID.Bins: 100
Histogram.MCPhotonPID.XMin: -400
Histogram.MCPhotonPID.XMax: 400
Histogram.MCPhotonPID.LogX: 1

Histogram.MCPhotonMomPID.Name: hMCPhotonMomPID
Histogram.MCPhotonMomPID.Title: MC matched Photon MomPID;MC Photon MomPID;Entries
Histogram.MCPhotonMomPID.Bins: 100
Histogram.MCPhotonMomPID.XMin: -400
Histogram.MCPhotonMomPID.XMax: 400
Histogram.MCPhotonMomPID.LogX: 1

# Basic kinematic histograms
Histogram.RefPt.Name: hRefPt
Histogram.RefPt.Title: MC matched Jet p_{T};MC p_{T} [GeV/c];Entries
Histogram.RefPt.Bins: 50
Histogram.RefPt.XMax: 200
Histogram.RefPt.LogY: 1

Histogram.RefEta.Name: hRefEta
Histogram.RefEta.Title: MC matched Jet #eta;MC #eta;Entries
Histogram.RefEta.XMin: -2.5
Histogram.RefEta.XMax: 2.5

Histogram.RefPhi.Name: hRefPhi
Histogram.RefPhi.Title: MC matched Jet #phi;MC #phi [rad];Entries
Histogram.RefPhi.XMin: -3.14159
Histogram.RefPhi.XMax: 3.14159

# Histogram.MCDeltaPhi.Name: hMCDeltaPhi
# Histogram.MCDeltaPhi.Title: MC matched #Delta#phi(#gamma, jet);MC #Delta#phi [rad];Entries
# Histogram.MCDeltaPhi.XMax: 3.14159

Histogram.RefXj.Name: hRefXj
Histogram.RefXj.Title: x_{j} = MC matched p_{T}^{jet} / E_{T}^{#gamma};MC x_{j};Entries
Histogram.RefXj.XMax: 2.0

# Jet substructure histograms
Histogram.RefMass.Name: hRefMass
Histogram.RefMass.Title: MC matched Ref Mass;MC matched m [GeV/c^{2}];Entries
Histogram.RefMass.Bins: 20
Histogram.RefMass.XMax: 20

Histogram.RefDynSplit.Name: hRefDynSplit
Histogram.RefDynSplit.Title: MC matched Number of Splits;nSD;Entries
Histogram.RefDynSplit.Bins: 15
Histogram.RefDynSplit.XMax: 15

Histogram.RefDynKt.Name: hRefDynKt
Histogram.RefDynKt.Title: MC matched Dynamical Groomed k_{T};k_{T} [GeV/c];Entries
Histogram.RefDynKt.Bins: 30
Histogram.RefDynKt.XMax: 30
Histogram.RefDynKt.LogY: 1

Histogram.RefDynZ.Name: hRefDynZ
Histogram.RefDynZ.Title: MC matched Dynamical Groomed z;z;Entries
Histogram.RefDynZ.Bins: 20
Histogram.RefDynZ.XMax: 0.5

Histogram.RefGirth.Name: hRefGirth
Histogram.RefGirth.Title: MC matched Jet Girth;girth;Entries
Histogram.RefGirth.Bins: 20
Histogram.RefGirth.XMax: 0.2

Histogram.RefThrust.Name: hRefThrust
Histogram.RefThrust.Title: MC matched Jet Thrust;thrust;Entries
Histogram.RefThrust.Bins: 20
Histogram.RefThrust.XMax: 0.5

Histogram.RefLHA.Name: hRefLHA
Histogram.RefLHA.Title: MC matched Jet LHA;LHA;Entries
Histogram.RefLHA.Bins: 20
Histogram.RefLHA.XMax: 1.0

Histogram.RefPtD.Name: hRefPtD
Histogram.RefPtD.Title: MC matched Jet p_{T}D;p_{T}D;Entries
Histogram.RefPtD.Bins: 20
Histogram.RefPtD.XMax: 1.0

Histogram.RefJetArea.Name: hRefJetArea
Histogram.RefJetArea.Title: MC matched Jet Area;Area;Entries
Histogram.RefJetArea.Bins: 50
Histogram.RefJetArea.XMax: 1

Histogram.RefDynDeltaR.Name: hRefDynDeltaR
Histogram.RefDynDeltaR.Title: MC matched Jet R_{g};R_{g};Entries
Histogram.RefDynDeltaR.Bins: 15
Histogram.RefDynDeltaR.XMin: -0.05
Histogram.RefDynDeltaR.XMax: 0.2

Histogram.RefIntJetMulti.Name: hRefIntJetMulti
Histogram.RefIntJetMulti.Title: MC matched Intra Jet Multiplicity;Intra Jet Multiplicity;Entries
Histogram.RefIntJetMulti.Bins: 25
Histogram.RefIntJetMulti.XMax: 25

# =============================================================================
# 2D HISTOGRAMS AND PROFILES
# =============================================================================

# Photon Gen pT vs Reco pT
Histogram.PhotonGenVsReco.Name: h2PhotonGenVsReco
Histogram.PhotonGenVsReco.Title: MC Photon E_{T} vs Reco Photon E_{T};Reco Photon E_{T};MC Photon E_{T} [GeV/c]
Histogram.PhotonGenVsReco.XBins: 50
Histogram.PhotonGenVsReco.XMin: 0
Histogram.PhotonGenVsReco.XMax: 400
Histogram.PhotonGenVsReco.YBins: 50
Histogram.PhotonGenVsReco.YMin: 0
Histogram.PhotonGenVsReco.YMax: 400
Histogram.PhotonGenVsReco.PlotType: TH2F
Histogram.PhotonGenVsReco.ColorMap: viridis
Histogram.PhotonGenVsReco.LogZ: 1

# Jet pT vs Eta
Histogram.JetPtVsEta.Name: h2JetPtVsEta
Histogram.JetPtVsEta.Title: Jet p_{T} vs #eta;#eta;p_{T} [GeV/c]
Histogram.JetPtVsEta.XBins: 50
Histogram.JetPtVsEta.XMin: -2.5
Histogram.JetPtVsEta.XMax: 2.5
Histogram.JetPtVsEta.YBins: 50
Histogram.JetPtVsEta.YMin: 0
Histogram.JetPtVsEta.YMax: 400
Histogram.JetPtVsEta.PlotType: TH2F
Histogram.JetPtVsEta.ColorMap: viridis
Histogram.JetPtVsEta.LogZ: 1

# Dynamical splitting vs pT
# Histogram.DynSplitVsPt.Name: h2DynSplitVsPt
# Histogram.DynSplitVsPt.Title: Dynamical Groomed Splitting vs p_{T};p_{T} [GeV/c];nSD [GeV/c]
# Histogram.DynSplitVsPt.XBins: 15
# Histogram.DynSplitVsPt.XMin: 0
# Histogram.DynSplitVsPt.XMax: 15
# Histogram.DynSplitVsPt.YBins: 50
# Histogram.DynSplitVsPt.YMin: 0
# Histogram.DynSplitVsPt.YMax: 400
# Histogram.DynSplitVsPt.PlotType: TH2F
# Histogram.DynSplitVsPt.ColorMap: viridis
# Histogram.DynSplitVsPt.LogZ: 0

# Profile version
# Histogram.ProfileDynSplitVsPt.Name: pDynSplitVsPt
# Histogram.ProfileDynSplitVsPt.Title: Dynamical Groomed Splitting vs p_{T};p_{T} [GeV/c];<#sqrt{z#theta}> [GeV/c]
# Histogram.ProfileDynSplitVsPt.XBins: 15
# Histogram.ProfileDynSplitVsPt.XMin: 0
# Histogram.ProfileDynSplitVsPt.XMax: 15
# Histogram.ProfileDynSplitVsPt.YBins: 50
# Histogram.ProfileDynSplitVsPt.YMin: 0
# Histogram.ProfileDynSplitVsPt.YMax: 400
# Histogram.ProfileDynSplitVsPt.PlotType:  TProfile
# Histogram.ProfileDynSplitVsPt.Color: auto
# Histogram.ProfileDynSplitVsPt.LineWidth: 2
# Histogram.ProfileDynSplitVsPt.MarkerStyle: kFullCircle
# Histogram.ProfileDynSplitVsPt.MarkerSize: 0.8
# Histogram.ProfileDynSplitVsPt.DrawOption: E1

# Jet mass vs pT
Histogram.JetMassVsPt.Name: h2JetMassVsPt
Histogram.JetMassVsPt.Title: Jet Mass vs p_{T};p_{T} [GeV/c];m [GeV/c^{2}]
Histogram.JetMassVsPt.XBins: 20
Histogram.JetMassVsPt.XMin: 0
Histogram.JetMassVsPt.XMax: 20
Histogram.JetMassVsPt.YBins: 50
Histogram.JetMassVsPt.YMin: 0
Histogram.JetMassVsPt.YMax: 400
Histogram.JetMassVsPt.PlotType: TH2F
Histogram.JetMassVsPt.ColorMap: viridis
Histogram.JetMassVsPt.LogZ: 0

# =============================================================================
# CENTRALITY-DEPENDENT SETTINGS
# =============================================================================

# Centrality bin definitions (should match main config)
CentralityBins: 0,60,180

# Centrality-specific plot colors (override auto colors)
# CentralityColors.0to10: #5790fc
# CentralityColors.10to30: #f89c20
# CentralityColors.30to50: #e42536
# CentralityColors.50to70: #964a8b
# CentralityColors.70to100: #9c9ca1
# CentralityColors.100to200: #7a21dd

CentralityColors.0to60: #5790fc
CentralityColors.60to180: #e42536

# Centrality labels for legends
CentralityLabels.0to60: 0-30%
CentralityLabels.60to180: 30-90%
# CentralityLabels.30to50: 30-50%
# CentralityLabels.50to70: 50-70%
# CentralityLabels.70to100: 70-100%
# CentralityLabels.100to200: Peripheral

# =============================================================================
# JET COLLECTION SETTINGS
# =============================================================================

# Jet collection specific settings (override default colors/styles)
# JetCollection.ak4PFJets.Color: #5790fc
# JetCollection.ak4PFJets.LineStyle: 1
# JetCollection.ak4PFJets.MarkerStyle: 20

# JetCollection.ak4CaloJets.Color: #f89c20
# JetCollection.ak4CaloJets.LineStyle: 2
# JetCollection.ak4CaloJets.MarkerStyle: 21

# JetCollection.ak3PFJets.Color: #e42536
# JetCollection.ak3PFJets.LineStyle: 3
# JetCollection.ak3PFJets.MarkerStyle: 22

# =============================================================================
# OVERLAY PLOTS CONFIGURATION
# =============================================================================

# Define which plots should be overlaid across centrality bins
OverlayPlots: JetPt,JetEta,DeltaPhi,Xj,DynSplit,JetMass,JetArea,DynDeltaR,IntJetMulti

# Enable different types of overlays
OverlayByCentrality: 1
OverlayByJetCollection: 1

# Which jet collections to include in overlays (comma-separated)
# Options: AK2Z1,AK4Z2,AK6Z3,AK8Z4,AK8Z5 or "all"
OverlayJetCollections: AK2Z1,AK2Z2,AK2Z3

# Which centrality bins to include in overlays (comma-separated) 
# Format: cent0to60,cent60to180 or "all"
OverlayCentralityBins: cent0to60,cent60to180

# Overlay plot settings
Overlay.DrawLegend: 1
Overlay.LegendPosition: 0.65,0.65,0.9,0.9
Overlay.LegendTextSize: 0.03
Overlay.LegendFillStyle: 0
Overlay.LegendBorderSize: 0

# Ratio plots for overlays
Overlay.DrawRatio: 1
Overlay.RatioYTitle: Ratio
Overlay.RatioYRange: 0.5,1.5
Overlay.RatioGridY: 1

# =============================================================================
# SPECIAL PLOTS
# =============================================================================

# Event-level histograms (not binned by centrality)
EventHistograms: nPhotons,nJets,EventWeight,vz,hiHF,centrality

Histogram.EventWeight.Name: hEventWeight
Histogram.EventWeight.Title: Event Weight;Weight;Entries
Histogram.EventWeight.Bins: 10000
Histogram.EventWeight.XMax: 2000
Histogram.EventWeight.LogY: 1

# =============================================================================
# OUTPUT CONTROL
# =============================================================================

# Which plots to generate (can be used to disable specific plots)
# EnabledPlots.JetPt: 1
# EnabledPlots.JetEta: 1
# EnabledPlots.JetPhi: 1
# EnabledPlots.DeltaPhi: 1
# EnabledPlots.Xj: 1
# EnabledPlots.PhotonEt: 1
# EnabledPlots.PhotonEta: 1
# EnabledPlots.JetMass: 1
# EnabledPlots.DynSplit: 1
# EnabledPlots.DynKt: 1
# EnabledPlots.DynZ: 1
# EnabledPlots.Girth: 1
# EnabledPlots.Thrust: 1
# EnabledPlots.LHA: 1
# EnabledPlots.PtD: 1
# EnabledPlots.JetPtVsEta: 1
# EnabledPlots.DynSplitVsPt: 1
# EnabledPlots.JetMassVsPt: 1

# Enable overlay plots
# EnabledPlots.Overlays: 1

# Enable event-level plots
# EnabledPlots.EventLevel: 1

# =============================================================================
# ADVANCED PLOTTING OPTIONS
# =============================================================================

# Statistical boxes
ShowStatBox: 0
StatBoxPosition: 0.7,0.7,0.9,0.9

# Grid lines
ShowGridX: 0
ShowGridY: 0

# Normalization options
NormalizeHistograms: 0
NormalizationStyle: integral

# Axis range auto-adjustment
AutoAdjustYRange: 1
YRangeMarginTop: 0.1
YRangeMarginBottom: 0.0

# Error bars
ShowErrorBars: 1
ErrorBarStyle: 0

# =============================================================================
# ROOT FILE STRUCTURE SETTINGS
# =============================================================================

# Root file structure (nested directories)
UseNestedStructure: 1
JetDirectories: AK2Z1,AK2Z2,AK2Z3,AK2Z4,AK3Z1,AK3Z2,AK3Z3,AK3Z4,AK4Z1,AK4Z2,AK4Z3,AK4Z4,AK5Z1,AK5Z2,AK5Z3,AK5Z4,AK6Z1,AK6Z2,AK6Z3,AK6Z4,AK8Z1,AK8Z2,AK8Z3,AK8Z4
CentralityBins: 0,60,180
DefaultJetDir: AK2Z2
DefaultCentralityBin: cent0to60

# Histogram location within nested structure (empty for direct access)
HistogramSubdir: 

# =============================================================================
# RATIO PLOT SETTINGS
# =============================================================================

# Enable ratio plots
EnableRatioPlots: 1

# Ratio plot pairs (format: histogram1:histogram2:label1:label2)
RatioPlotPairs: AK2Z2/cent0to60/Xj:AK4Z2/cent0to60/Xj:AK2PF z_{cut}>0.2:AK4PF z_{cut}>0.2

# Ratio plot settings
RatioYMin: 0.5
RatioYMax: 1.5
RatioYTitle: Ratio

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
