# =============================================================================
# Gamma-Jet Analysis Plotting Configuration
# =============================================================================
# This file defines all plotting options, histogram specifications, and style
# settings for the gamma-jet analysis framework.
# 
# Author: Generated for CMS Heavy Ion Analysis
# Date: 2025-05-25
# =============================================================================

# General histograms (binned by centrality, not per-jet)
GeneralHistograms: MCPhotonEt,MCPhotonEta,MCPhotonPhi,MCPhotonPID,MCPhotonMomPID,PhotonGenMatch,PhotonRecoEtVsGenEt

# Jet histograms (binned by centrality and per-jet collection)
JetHistograms: RefPt,RefEta,RefPhi,RefMass,RefDynSplit,RefDynKt,RefDynZ,RefDynDeltaR,RefIntJetMulti,RefGirth,RefThrust,RefLHA,RefPtD,RefJetEtaVsRefJetPt,RefJetPtVsRefJetMass,RefJetPtVsRefJetGirth,RefJetPtVsRefJetThrust,RefJetPtVsRefJetPtD,JetPtVsRefPt,JetMassVsRefMass,JetGirthVsRefGirth,JetThrustVsRefThrust,JetLHAVsRefLHA,JetPtDVsRefPtD,JetPtRes,JetMassRes,JetGirthRes,JetThrustRes,JetLHARes,JetPtDRes
# RefXj,

# =============================================================================
# HISTOGRAM DEFINITIONS
# =============================================================================

HistogramConfigFile: Histograms.config

# =============================================================================
# GENERAL PLOTTING SETTINGS
# =============================================================================

# Enable/disable plotting functionality
# EnablePlotting: 1
# SavePlots: 1
PlotFormats: png,root


# CMS Style and Labeling
# UseCMSStyle: 1
CMSLabel: Preliminary 
CMSEnergyText: 5.36 TeV PbPb
CMSLuminosity: 1.72 nb^{-1}
CMSExtraText: Simulation

# Color scheme selection (petroff6, petroff10, viridis)
ColorScheme: petroff6
UseColorBlind: 1

# Canvas settings
CanvasWidth: 800
CanvasHeight: 600
CanvasMarginLeft: 0.15
CanvasMarginRight: 0.05
CanvasMarginTop: 0.08
CanvasMarginBottom: 0.12

# =============================================================================
# SELECTION CRITERIA (for automatic selection text generation)
# =============================================================================

# Photon selection criteria
SelectionPhotonPtMin: 80
# SelectionPhotonPtMax: 200
SelectionPhotonEtaMax: 1.44

# Jet selection criteria
SelectionJetPtMin: 40
SelectionJetEtaMax: 2.0

# Angular correlation criteria
SelectionDeltaPhiMin: 2#pi/3

# Alternative: Use custom selection text (uncomment to override automatic generation)
SelectionText: Gen-Matched Photon, p_{T}^{#gamma}>80 GeV, |#eta^{#gamma}| < 1.44, p_{T}^{jet} > 40 GeV, #Delta#phi > 0.1 to remove photons inside jets, Should be handled with PhoIso

# =============================================================================
# MC Truth HISTOGRAMS
# =============================================================================

# Photon histograms

Histogram.PhotonGenMatch.Name: hPhotonGenMatch
Histogram.PhotonGenMatch.Title: Photon Gen Match Index;Photon Gen Match Index;Entries
Histogram.PhotonGenMatch.Bins: 10
Histogram.PhotonGenMatch.XMax: 10

Histogram.MCPhotonEt.Name: hMCPhotonEt
Histogram.MCPhotonEt.Title: MC matched Photon E_{T};MC E_{T} [GeV];Entries
Histogram.MCPhotonEt.Bins: 100
Histogram.MCPhotonEt.XMax: 400
Histogram.MCPhotonEt.BinEdgesX: 40,80,100,120,150,200,500
Histogram.MCPhotonEt.LogY: 1

Histogram.MCPhotonEta.Name: hMCPhotonEta
Histogram.MCPhotonEta.Title: MC matched Photon #eta;MC #eta;Entries
Histogram.MCPhotonEta.XMin: -2.5
Histogram.MCPhotonEta.XMax: 2.5
Histogram.MCPhotonEta.MarkerStyle: kFullSquare

Histogram.MCPhotonPhi.Name: hMCPhotonPhi
Histogram.MCPhotonPhi.Title: MC matched Photon #phi;MC #phi;Entries
Histogram.MCPhotonPhi.XMin: -3.14159
Histogram.MCPhotonPhi.XMax: 3.14159

Histogram.MCPhotonPID.Name: hMCPhotonPID
Histogram.MCPhotonPID.Title: MC matched Photon PID;MC Photon PID;Entries
Histogram.MCPhotonPID.Bins: 1
Histogram.MCPhotonPID.XMin: 21
Histogram.MCPhotonPID.XMax: 23
Histogram.MCPhotonPID.LogX: 1

Histogram.MCPhotonMomPID.Name: hMCPhotonMomPID
Histogram.MCPhotonMomPID.Title: MC matched Photon MomPID;MC Photon MomPID;Entries
Histogram.MCPhotonMomPID.Bins: 50
Histogram.MCPhotonMomPID.XMin: -24
Histogram.MCPhotonMomPID.XMax: 25

# Basic kinematic histograms
Histogram.RefPt.Name: hRefPt
Histogram.RefPt.Title: MC matched Jet p_{T};MC p_{T} [GeV/c];Entries
Histogram.RefPt.XMax: 200
Histogram.RefPt.LogY: 1

Histogram.RefEta.Name: hRefEta
Histogram.RefEta.Title: MC matched Jet #eta;MC #eta;Entries
Histogram.RefEta.XMin: -2.5
Histogram.RefEta.XMax: 2.5

Histogram.RefPhi.Name: hRefPhi
Histogram.RefPhi.Title: MC matched Jet #phi;MC #phi [rad];Entries
Histogram.RefPhi.XMin: -3.14159
Histogram.RefPhi.XMax: 3.14159

# Histogram.MCDeltaPhi.Name: hMCDeltaPhi
# Histogram.MCDeltaPhi.Title: MC matched #Delta#phi(#gamma, jet);MC #Delta#phi [rad];Entries
