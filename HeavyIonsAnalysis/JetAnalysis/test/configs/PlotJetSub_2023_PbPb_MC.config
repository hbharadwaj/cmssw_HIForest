# =============================================================================
# CENTRALITY-DEPENDENT SETTINGS
# =============================================================================

# Centrality bin definitions (should match main config)
CentralityBins: 0,60,180

# Centrality-specific plot colors (override auto colors)
# CentralityColors.0to10: #5790fc
# CentralityColors.10to30: #f89c20
# CentralityColors.30to50: #e42536
# CentralityColors.50to70: #964a8b
# CentralityColors.70to100: #9c9ca1
# CentralityColors.100to200: #7a21dd

CentralityColors.0to60: #5790fc
CentralityColors.60to180: #e42536

# Centrality labels for legends
CentralityLabels.0to60: 0-30%
CentralityLabels.60to180: 30-90%
# CentralityLabels.30to50: 30-50%
# CentralityLabels.50to70: 50-70%
# CentralityLabels.70to100: 70-100%
# CentralityLabels.100to200: Peripheral

# =============================================================================
# JET COLLECTION SETTINGS
# =============================================================================

# Jet collection specific settings (override default colors/styles)
# JetCollection.ak4PFJets.Color: #5790fc
# JetCollection.ak4PFJets.LineStyle: 1
# JetCollection.ak4PFJets.MarkerStyle: 20

# JetCollection.ak4CaloJets.Color: #f89c20
# JetCollection.ak4CaloJets.LineStyle: 2
# JetCollection.ak4CaloJets.MarkerStyle: 21

# JetCollection.ak3PFJets.Color: #e42536
# JetCollection.ak3PFJets.LineStyle: 3
# JetCollection.ak3PFJets.MarkerStyle: 22

# =============================================================================
# OVERLAY PLOTS CONFIGURATION
# =============================================================================

# Define which plots should be overlaid across centrality bins
OverlayPlots: JetPt,JetEta,DeltaPhi,Xj,DynSplit,JetMass,DynDeltaR,IntJetMulti

# Enable different types of overlays
OverlayByCentrality: 1
OverlayByJetCollection: 1

# Which jet collections to include in overlays (comma-separated)
# Options: AK2Z1,AK4Z2,AK6Z3,AK8Z4,AK8Z5 or "all"
OverlayJetCollections: AK2Z1,AK2Z2,AK2Z3

# Which centrality bins to include in overlays (comma-separated) 
# Format: cent0to60,cent60to180 or "all"
OverlayCentralityBins: cent0to60,cent60to180

# Overlay plot settings
Overlay.DrawLegend: 1
Overlay.LegendPosition: 0.65,0.65,0.9,0.9
Overlay.LegendTextSize: 0.03
Overlay.LegendFillStyle: 0
Overlay.LegendBorderSize: 0

# Ratio plots for overlays
Overlay.DrawRatio: 1
Overlay.RatioYTitle: Ratio
Overlay.RatioYRange: 0.5,1.5
Overlay.RatioGridY: 1

EventHistograms: EventWeight

Histogram.EventWeight.Name: hEventWeight
Histogram.EventWeight.Title: Event Weight;Weight;Entries
Histogram.EventWeight.Bins: 10000
Histogram.EventWeight.XMax: 2000
Histogram.EventWeight.LogY: 1

# =============================================================================
# OUTPUT CONTROL
# =============================================================================

# Which plots to generate (can be used to disable specific plots)
# EnabledPlots.JetPt: 1
# EnabledPlots.JetEta: 1
# EnabledPlots.JetPhi: 1
# EnabledPlots.DeltaPhi: 1
# EnabledPlots.Xj: 1
# EnabledPlots.PhotonEt: 1
# EnabledPlots.PhotonEta: 1
# EnabledPlots.JetMass: 1
# EnabledPlots.DynSplit: 1
# EnabledPlots.DynKt: 1
# EnabledPlots.DynZ: 1
# EnabledPlots.Girth: 1
# EnabledPlots.Thrust: 1
# EnabledPlots.LHA: 1
# EnabledPlots.PtD: 1
# EnabledPlots.JetPtVsEta: 1
# EnabledPlots.DynSplitVsPt: 1
# EnabledPlots.JetMassVsPt: 1

# Enable overlay plots
# EnabledPlots.Overlays: 1

# Enable event-level plots
# EnabledPlots.EventLevel: 1

# =============================================================================
# ADVANCED PLOTTING OPTIONS
# =============================================================================

# Statistical boxes
ShowStatBox: 0
StatBoxPosition: 0.7,0.7,0.9,0.9

# Grid lines
ShowGridX: 0
ShowGridY: 0

# Normalization options
NormalizeHistograms: 0
NormalizationStyle: integral

# Axis range auto-adjustment
AutoAdjustYRange: 1
YRangeMarginTop: 0.1
YRangeMarginBottom: 0.0

# Error bars
ShowErrorBars: 1
ErrorBarStyle: 0

# =============================================================================
# ROOT FILE STRUCTURE SETTINGS
# =============================================================================

# Root file structure (nested directories)
UseNestedStructure: 1
JetDirectories: AK2Z1,AK2Z2,AK2Z3,AK3Z1,AK3Z2,AK3Z3,AK4Z1,AK4Z2,AK4Z3,AK5Z1,AK5Z2,AK5Z3,AK6Z1,AK6Z2,AK6Z3,AK8Z1,AK8Z2,AK8Z3
CentralityBins: 0,60,180
DefaultJetDir: AK2Z2
DefaultCentralityBin: cent0to60

# Histogram location within nested structure (empty for direct access)
HistogramSubdir: 

# =============================================================================
# RATIO PLOT SETTINGS
# =============================================================================

# Enable ratio plots
EnableRatioPlots: 1

# Ratio plot pairs (format: histogram1:histogram2:label1:label2)
RatioPlotPairs: AK2Z2/cent0to60/Xj:AK4Z2/cent0to60/Xj:AK2PF z_{cut}>0.2:AK4PF z_{cut}>0.2

# Ratio plot settings
RatioYMin: 0.5
RatioYMax: 1.5
RatioYTitle: Ratio

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
