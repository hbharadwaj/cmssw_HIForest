# Jet substructure histograms
Histogram.RefMass.Name: hRefMass
Histogram.RefMass.Title: MC matched Ref Mass;MC matched m [GeV/c^{2}];Entries
Histogram.RefMass.Bins: 20
Histogram.RefMass.XMax: 20

Histogram.RefGirth.Name: hRefGirth
Histogram.RefGirth.Title: MC matched Jet Girth;girth;Entries
Histogram.RefGirth.Bins: 20
Histogram.RefGirth.XMax: 0.2

Histogram.RefThrust.Name: hRefThrust
Histogram.RefThrust.Title: MC matched Jet Thrust;thrust;Entries
Histogram.RefThrust.Bins: 20
Histogram.RefThrust.XMax: 0.5

Histogram.RefLHA.Name: hRefLHA
Histogram.RefLHA.Title: MC matched Jet LHA;LHA;Entries
Histogram.RefLHA.Bins: 20
Histogram.RefLHA.XMax: 1.0

Histogram.RefPtD.Name: hRefPtD
Histogram.RefPtD.Title: MC matched Jet p_{T}D;p_{T}D;Entries
Histogram.RefPtD.Bins: 20
Histogram.RefPtD.XMax: 1.0

Histogram.RefDynSplit.Name: hRefDynSplit
Histogram.RefDynSplit.Title: MC matched Number of Splits;nSD;Entries
Histogram.RefDynSplit.Bins: 15
Histogram.RefDynSplit.XMax: 15

Histogram.RefDynKt.Name: hRefDynKt
Histogram.RefDynKt.Title: MC matched Dynamical Groomed k_{T};k_{T} [GeV/c];Entries
Histogram.RefDynKt.Bins: 30
Histogram.RefDynKt.XMax: 15
Histogram.RefDynKt.LogY: 1
Histogram.RefDynKt.BinEdgesX: 0,0.5,1,1.5,2,3,4,6,10,15

Histogram.RefDynZ.Name: hRefDynZ
Histogram.RefDynZ.Title: MC matched Dynamical Groomed z;z;Entries
Histogram.RefDynZ.Bins: 20
Histogram.RefDynZ.XMax: 0.5

Histogram.RefDynDeltaR.Name: hRefDynDeltaR
Histogram.RefDynDeltaR.Title: MC matched Jet R_{g};R_{g};Entries
# Histogram.RefDynDeltaR.Bins: 15
# Histogram.RefDynDeltaR.XMin: -0.05
# Histogram.RefDynDeltaR.XMax: 0.2
Histogram.RefDynDeltaR.BinEdgesX: -0.05,0,0.04,0.08,0.12,0.2

Histogram.RefIntJetMulti.Name: hRefIntJetMulti
Histogram.RefIntJetMulti.Title: MC matched Intra Jet Multiplicity;Intra Jet Multiplicity;Entries
Histogram.RefIntJetMulti.Bins: 25
Histogram.RefIntJetMulti.XMax: 25

