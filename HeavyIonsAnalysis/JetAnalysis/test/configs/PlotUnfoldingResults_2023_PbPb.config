# =============================================================================
# PROJECTION AXIS AND BINNING CUSTOMIZATION (DEFAULTS)
# =============================================================================
# For each 2D unfolding set, specify which projections to compare and the bin ranges (inclusive, ROOT-style)
# These can be overridden per set as needed
Unfold2D_girth_xJ.ProjectionsToCompare: x,y
Unfold2D_girth_xJ.Projection.x: 1,-1
Unfold2D_girth_xJ.Projection.y: 1,-1
Unfold2D_dyn_deltaR_xJ.ProjectionsToCompare: x,y
Unfold2D_dyn_deltaR_xJ.Projection.x: 1,-1
Unfold2D_dyn_deltaR_xJ.Projection.y: 1,-1
# =============================================================================
# Unfolding Results Plotting Configuration for 2023 PbPb Data
# =============================================================================
# System-specific configuration for 2023 PbPb unfolding results plotting
# 
# Author: CMS Heavy Ion Team
# Date: 2025-07-14
# =============================================================================

# Include common configuration
IncludeConfig: PlotUnfoldingResults_Common.config
PlotFormats: png,root

# =============================================================================
# SYSTEM-SPECIFIC SETTINGS
# =============================================================================

# System identification
System: 2023_PbPb
DataType: Data+MC

# CMS labeling for PbPb
CMSEnergyText: 5.36 TeV PbPb
CMSLuminosity: 1.72 nb^{-1}

# Input files
InputFile.PbPb2023: /eos/user/b/bharikri/www/Run3GammaJet/2025_08_29/Unfolding/2023_PbPb/2025_08_29_Bayes_Unfolded_phoEt_100_test_xJ_2D_reweighted_optimized_results.root:/afs/cern.ch/user/b/bharikri/private/HeavyIon/run3_gamma_jet/CMSSW_13_2_13/src/HeavyIonsAnalysis/JetAnalysis/test/configs/PlotJetSub_2023_PbPb_Data.config:2023 PbPb xJ reweight

# Output directory
OutputDir: /eos/user/b/bharikri/www/Run3GammaJet/2025_08_29/Unfolding/plots/2023_PbPb_reweighted_2D_xJ
OutputPrefix: 2025_08_29_PbPb_2023_UnfoldingPlots

# =============================================================================
# UNFOLDING SETS AND TESTS SPECIFIC TO 2023 PbPb
# =============================================================================

# Available unfolding sets (auto-detected if not specified)
UnfoldingSets: Unfold1D_xJ,Unfold2D_girth_xJ,Unfold2D_dyn_deltaR_xJ

# Available tests (auto-detected if not specified)
Tests: Nominal,Closure,Split,Bottomline

# Primary unfolding method for this dataset
PrimaryMethod: MatrixInversion

# =============================================================================
# CENTRALITY-SPECIFIC SETTINGS
# =============================================================================

# Centrality bins for PbPb
CentralityBins: 0,30

# Centrality labels
CentralityLabel.0to30: 0-30%

# Selection text for PbPb
SelectionText.Custom: p_{T}^{#gamma}>100 GeV, |#eta^{#gamma}| < 1.44\\np_{T}^{jet} > 40 GeV, Centrality 0-30%\\n#Delta#phi > 2#pi/3

# =============================================================================
# JET COLLECTIONS FOR 2023 PbPb
# =============================================================================

# Primary jet collections to analyze
JetCollections: AK2Z1,AK2Z2,AK2Z3

# Default jet collection for analysis
DefaultJetCollection: AK2Z2

# =============================================================================
# SYSTEM-SPECIFIC PLOT SETTINGS
# =============================================================================

# Color scheme for PbPb (can override common)
ColorScheme: petroff6

# Additional PbPb-specific plots
PlotCentralityDependence: 1
PlotJetCollectionComparison: 1

# =============================================================================
# COMPARISON WITH PP DATA
# =============================================================================

# Enable PbPb vs PP comparison (if PP data available)
EnablePbPbPpComparison: 1
ComparisonFile.PP2024: /eos/user/b/bharikri/www/Run3GammaJet/2025_07_03/phoEt_100/2024_PP/Unfolding/2025_07_03_Bayes_Unfolded_phoEt_100_optimized_results.root

# =============================================================================
# UNFOLDING SYSTEMATICS
# =============================================================================

# Systematic uncertainty plots
PlotSystematics: 1
Systematics.TestComparisons: Closure,Split,Bottomline
Systematics.MethodComparisons: MatrixInversion,Bayes

# =============================================================================
# END OF 2023 PbPb CONFIGURATION
# =============================================================================
