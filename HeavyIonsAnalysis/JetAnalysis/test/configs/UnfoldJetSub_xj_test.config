# System Configuration 
System 2023_PbPb
DataType Data+MC

# Input/Output Configuration
DataInputFile /eos/user/b/bharikri/www/Run3GammaJet/2025_06_11/2023_PbPb/2025_06_11_HiRawPrimeAll_full_combined.root
DataConfigFile /afs/cern.ch/user/b/bharikri/private/HeavyIon/run3_gamma_jet/CMSSW_13_2_13/src/HeavyIonsAnalysis/JetAnalysis/test/configs/JetSub_2023_PbPb_Data.config
MCInputFile /eos/user/b/bharikri/www/Run3GammaJet/2025_06_11/2023_PbPb/2025_06_11_QCDPhoton30_combined.root
MCConfigFile /afs/cern.ch/user/b/bharikri/private/HeavyIon/run3_gamma_jet/CMSSW_13_2_13/src/HeavyIonsAnalysis/JetAnalysis/test/configs/JetSub_2023_PbPb_MC.config

OutputDir /eos/user/b/bharikri/www/Run3GammaJet/2025_06_15/2023_PbPb/Unfolding/
OutputPrefix 2025_06_15_Unfolded

# Logging Control
Verbosity 2

# Unfolding Configuration
# Options: MatrixInversion, SVD, Bayes
UnfoldingMethod MatrixInversion
# Used for iterative methods like Bayes
UnfoldingIterations 4
# Regularization parameter for SVD
UnfoldingRegParam 4

# Observable Configuration
# Unfold girth for initial test (has proper measured and truth branches)
ObservablesToUnfold girth

# Binning Configuration 
GirthBins 0.0,0.02,0.04,0.08,0.12
JetPtBins 40,80,200
PhotonEtBins 80,150,500

# TUnfold Configuration
TUnfoldTau 0.001
TUnfoldRegMode Size

# Analysis Cases - Using just one collection for initial testing
AnalysisCases AK2Z2

# Centrality Bins
CentralityBins 0 30

# Test Configuration
TestMode None
