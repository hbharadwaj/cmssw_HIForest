# =============================================================================
# CMS Gamma-Jet Analysis Configuration with Data-MC Comparison Support
# =============================================================================
# Enhanced configuration for plotting gamma-jet analysis results
# Supports both single ROOT file plotting and Data-MC comparisons
# Consistent with PlotJetSub_2023_PbPb_Data.config and PlotJetSub_2023_PbPb_MC.config
# 
# Author: Generated for CMS Heavy Ion Analysis
# Date: 2025-05-26
# =============================================================================

# =============================================================================
# GENERAL PLOTTING SETTINGS
# =============================================================================

# Enable/disable plotting functionality
# EnablePlotting: 1
# SavePlots: 1
PlotFormats: pdf,png,root

# ROOT file structure
UseNestedStructure: 1

# CMS Style and Labeling
UseCMSStyle: 1
CMSLabel: Preliminary
CMSEnergyText: 5.36 TeV PbPb
CMSLuminosity: 1.72 nb^{-1}
CMSExtraText: 

# Color scheme selection (petroff6, petroff10, viridis, default)
ColorScheme: petroff6
UseColorBlind: 1

# Canvas settings
CanvasWidth: 800
CanvasHeight: 600
CanvasMarginLeft: 0.15
CanvasMarginRight: 0.05
CanvasMarginTop: 0.08
CanvasMarginBottom: 0.12

# =============================================================================
# JETS AND CENTRALITY CONFIGURATION
# =============================================================================

# Jet Collections (consistent with Data/MC configs)
JetDirectories: AK2Z1,AK2Z2,AK2Z3,AK3Z1,AK3Z2,AK3Z3,AK4Z1,AK4Z2,AK4Z3,AK5Z1,AK5Z2,AK5Z3,AK6Z1,AK6Z2,AK6Z3,AK8Z1,AK8Z2,AK8Z3

# Centrality Bins (consistent with Data/MC configs)
CentralityBins: 0,60,180

# =============================================================================
# SELECTION CRITERIA (for automatic selection text generation)
# =============================================================================

# Photon selection criteria (consistent with Data/MC configs)
SelectionPhotonPtMin: 60
# SelectionPhotonPtMax: 200
SelectionPhotonEtaMax: 1.44

# Jet selection criteria (consistent with Data/MC configs)
SelectionJetPtMin: 40
SelectionJetEtaMax: 2.0

# Angular correlation criteria (consistent with Data/MC configs)
SelectionDeltaPhiMin: 2#pi/3

# Alternative: Use custom selection text (uncomment to override automatic generation)
SelectionText: p_{T}^{#gamma}>80 GeV, |#eta^{#gamma}| < 1.44, p_{T}^{jet} > 40 GeV, #Delta#phi > 0.1 to remove photons inside jets, Should be handled with PhoIso

# =============================================================================
# DATA-MC COMPARISON SETTINGS
# =============================================================================

# Data-MC Comparison Settings
DataMC.DataLabel: Data
DataMC.MCLabel: PYTHIA8
DataMC.DataColor: 1
DataMC.MCColor: 2
DataMC.DataMarkerStyle: 20
DataMC.MCMarkerStyle: 21
DataMC.DataMarkerSize: 0.8
DataMC.MCMarkerSize: 0.8
DataMC.DataLineWidth: 2
DataMC.MCLineWidth: 2

# Ratio Plot Settings
DataMC.RatioTitle: Data/MC
DataMC.RatioYMin: 0.5
DataMC.RatioYMax: 1.5
DataMC.RatioColor: 1
DataMC.RatioMarkerStyle: 20
DataMC.RatioMarkerSize: 0.6

# Canvas Settings for Data-MC
DataMC.CanvasWidth: 800
DataMC.CanvasHeight: 800
DataMC.UpperPadHeight: 0.7
DataMC.LowerPadHeight: 0.3

# Legend Settings
DataMC.LegendX1: 0.65
DataMC.LegendY1: 0.75
DataMC.LegendX2: 0.85
DataMC.LegendY2: 0.85

# Normalization Option (0=absolute, 1=normalized comparison)
DataMC.Normalize: 1

# =============================================================================
# HISTOGRAM DEFINITIONS (consistent with Data/MC config files)
# =============================================================================

# Basic kinematic histograms
Histogram.JetPt.Name: hJetPt
Histogram.JetPt.Title: Jet p_{T};p_{T} [GeV/c];Entries
Histogram.JetPt.Bins: 100
Histogram.JetPt.XMin: 0
Histogram.JetPt.XMax: 200
Histogram.JetPt.LogY: 1
Histogram.JetPt.PlotType: 1D
Histogram.JetPt.Color: auto
Histogram.JetPt.LineWidth: 2
Histogram.JetPt.DrawOption: hist
Histogram.JetPt.MarkerStyle: auto
Histogram.JetPt.MarkerSize: 0.8

Histogram.JetEta.Name: hJetEta
Histogram.JetEta.Title: Jet #eta;#eta;Entries
Histogram.JetEta.Bins: 50
Histogram.JetEta.XMin: -2.5
Histogram.JetEta.XMax: 2.5
Histogram.JetEta.LogY: 0
Histogram.JetEta.PlotType: 1D
Histogram.JetEta.Color: auto
Histogram.JetEta.LineWidth: 2
Histogram.JetEta.DrawOption: hist
Histogram.JetEta.MarkerStyle: auto
Histogram.JetEta.MarkerSize: 0.8

Histogram.JetPhi.Name: hJetPhi
Histogram.JetPhi.Title: Jet #phi;#phi [rad];Entries
Histogram.JetPhi.Bins: 50
Histogram.JetPhi.XMin: -3.14159
Histogram.JetPhi.XMax: 3.14159
Histogram.JetPhi.LogY: 0
Histogram.JetPhi.PlotType: 1D
Histogram.JetPhi.Color: auto
Histogram.JetPhi.LineWidth: 2
Histogram.JetPhi.DrawOption: hist
Histogram.JetPhi.MarkerStyle: auto
Histogram.JetPhi.MarkerSize: 0.8

Histogram.DeltaPhi.Name: hDeltaPhi
Histogram.DeltaPhi.Title: #Delta#phi(#gamma, jet);#Delta#phi [rad];Entries
Histogram.DeltaPhi.Bins: 50
Histogram.DeltaPhi.XMin: 0
Histogram.DeltaPhi.XMax: 3.14159
Histogram.DeltaPhi.LogY: 0
Histogram.DeltaPhi.PlotType: 1D
Histogram.DeltaPhi.Color: auto
Histogram.DeltaPhi.LineWidth: 2
Histogram.DeltaPhi.DrawOption: E1
Histogram.DeltaPhi.MarkerStyle: kFullCircle
Histogram.DeltaPhi.MarkerSize: 1.0

Histogram.Xj.Name: hXj
Histogram.Xj.Title: x_{j} = p_{T}^{jet} / E_{T}^{#gamma};x_{j};Entries
Histogram.Xj.Bins: 50
Histogram.Xj.XMin: 0
Histogram.Xj.XMax: 2.0
Histogram.Xj.LogY: 0
Histogram.Xj.PlotType: 1D
Histogram.Xj.Color: auto
Histogram.Xj.LineWidth: 2
Histogram.Xj.DrawOption: E1
Histogram.Xj.MarkerStyle: auto
Histogram.Xj.MarkerSize: 0.8

# Photon histograms
Histogram.PhotonEt.Name: hPhotonEt
Histogram.PhotonEt.Title: Photon E_{T};E_{T} [GeV];Entries
Histogram.PhotonEt.Bins: 100
Histogram.PhotonEt.XMin: 0
Histogram.PhotonEt.XMax: 400
Histogram.PhotonEt.LogY: 1
Histogram.PhotonEt.PlotType: 1D
Histogram.PhotonEt.Color: auto
Histogram.PhotonEt.LineWidth: 2
Histogram.PhotonEt.DrawOption: hist
Histogram.PhotonEt.MarkerStyle: auto
Histogram.PhotonEt.MarkerSize: 0.8

Histogram.PhotonEta.Name: hPhotonEta
Histogram.PhotonEta.Title: Photon #eta;#eta;Entries
Histogram.PhotonEta.Bins: 50
Histogram.PhotonEta.XMin: -2.5
Histogram.PhotonEta.XMax: 2.5
Histogram.PhotonEta.LogY: 0
Histogram.PhotonEta.PlotType: 1D
Histogram.PhotonEta.Color: auto
Histogram.PhotonEta.LineWidth: 2
Histogram.PhotonEta.DrawOption: E1
Histogram.PhotonEta.MarkerStyle: kFullSquare
Histogram.PhotonEta.MarkerSize: 0.9

# Jet substructure histograms
Histogram.JetMass.Name: hJetMass
Histogram.JetMass.Title: Jet Mass;m [GeV/c^{2}];Entries
Histogram.JetMass.Bins: 50
Histogram.JetMass.XMin: 0
Histogram.JetMass.XMax: 50
Histogram.JetMass.LogY: 0
Histogram.JetMass.PlotType: 1D
Histogram.JetMass.Color: auto
Histogram.JetMass.LineWidth: 2
Histogram.JetMass.DrawOption: hist
Histogram.JetMass.MarkerStyle: auto
Histogram.JetMass.MarkerSize: 0.8

Histogram.DynSplit.Name: hDynSplit
Histogram.DynSplit.Title: Dynamical Groomed Splitting Scale;#sqrt{z#theta} [GeV/c];Entries
Histogram.DynSplit.Bins: 50
Histogram.DynSplit.XMin: 0
Histogram.DynSplit.XMax: 50
Histogram.DynSplit.LogY: 1
Histogram.DynSplit.PlotType: 1D
Histogram.DynSplit.Color: auto
Histogram.DynSplit.LineWidth: 2
Histogram.DynSplit.DrawOption: E1
Histogram.DynSplit.MarkerStyle: kFullTriangleUp
Histogram.DynSplit.MarkerSize: 1.0

Histogram.DynKt.Name: hDynKt
Histogram.DynKt.Title: Dynamical Groomed k_{T};k_{T} [GeV/c];Entries
Histogram.DynKt.Bins: 50
Histogram.DynKt.XMin: 0
Histogram.DynKt.XMax: 50
Histogram.DynKt.LogY: 1
Histogram.DynKt.PlotType: 1D
Histogram.DynKt.Color: auto
Histogram.DynKt.LineWidth: 2
Histogram.DynKt.DrawOption: hist
Histogram.DynKt.MarkerStyle: auto
Histogram.DynKt.MarkerSize: 0.8

Histogram.DynZ.Name: hDynZ
Histogram.DynZ.Title: Dynamical Groomed z;z;Entries
Histogram.DynZ.Bins: 50
Histogram.DynZ.XMin: 0
Histogram.DynZ.XMax: 0.5
Histogram.DynZ.LogY: 0
Histogram.DynZ.PlotType: 1D
Histogram.DynZ.Color: auto
Histogram.DynZ.LineWidth: 2
Histogram.DynZ.DrawOption: E1
Histogram.DynZ.MarkerStyle: kFullDiamond
Histogram.DynZ.MarkerSize: 1.2

Histogram.Girth.Name: hGirth
Histogram.Girth.Title: Jet Girth;girth;Entries
Histogram.Girth.Bins: 50
Histogram.Girth.XMin: 0
Histogram.Girth.XMax: 0.5
Histogram.Girth.LogY: 0
Histogram.Girth.PlotType: 1D
Histogram.Girth.Color: auto
Histogram.Girth.LineWidth: 2
Histogram.Girth.DrawOption: hist
Histogram.Girth.MarkerStyle: auto
Histogram.Girth.MarkerSize: 0.8

Histogram.Thrust.Name: hThrust
Histogram.Thrust.Title: Jet Thrust;thrust;Entries
Histogram.Thrust.Bins: 50
Histogram.Thrust.XMin: 0
Histogram.Thrust.XMax: 1.0
Histogram.Thrust.LogY: 0
Histogram.Thrust.PlotType: 1D
Histogram.Thrust.Color: auto
Histogram.Thrust.LineWidth: 2
Histogram.Thrust.DrawOption: hist
Histogram.Thrust.MarkerStyle: auto
Histogram.Thrust.MarkerSize: 0.8
# =============================================================================
# 2D HISTOGRAMS AND PROFILES
# =============================================================================

# 2D Histogram example (if available in ROOT files)
Histogram.JetPtVsEta.Name: hJetPtVsEta
Histogram.JetPtVsEta.Title: Jet p_{T} vs #eta;#eta;p_{T} [GeV/c]
Histogram.JetPtVsEta.XBins: 50
Histogram.JetPtVsEta.XMin: -2.5
Histogram.JetPtVsEta.XMax: 2.5
Histogram.JetPtVsEta.YBins: 50
Histogram.JetPtVsEta.YMin: 0
Histogram.JetPtVsEta.YMax: 200
Histogram.JetPtVsEta.PlotType: 2D
Histogram.JetPtVsEta.DrawOption2D: colz
Histogram.JetPtVsEta.LogZ: 0
Histogram.JetPtVsEta.ColorMap: default

# =============================================================================
# OVERLAY AND OUTPUT SETTINGS
# =============================================================================

# Overlay Settings (specify which histograms to overlay)
OverlayPlots: JetPt,PhotonEt,DeltaPhi,Xj,JetMass,DynSplit,DynKt,DynZ,Girth,Thrust,JetArea,DynDeltaR,IntJetMulti
OverlayByCentrality: 1
OverlayByJetCollection: 1

# Output Directory Structure
CreateSubdirectories: 1
Subdirectory.1D: 1D_plots
Subdirectory.2D: 2D_plots
Subdirectory.Profiles: profile_plots
Subdirectory.Overlays: overlay_plots
Subdirectory.DataMC: DataMC_comparisons

# =============================================================================
# LEGEND AND STYLING OPTIONS
# =============================================================================

# Legend positioning options
Legend.Position: right
Overlay.LegendPosition: 0.65,0.65,0.9,0.9
Overlay.LegendBorderSize: 0
Overlay.LegendFillStyle: 0

# Additional styling options
Line.Width: 2
Marker.Size: 0.8
Text.Font: 42
Text.Size: 0.04

# Color scheme options
Colors.Data: 1
Colors.MC: 2,4,6,8
Colors.Systematic: 15
