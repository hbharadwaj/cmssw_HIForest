Histogram.PtD.PlotType: 1D
Histogram.PtD.Color: auto
Histogram.PtD.LineWidth: 2
Histogram.PtD.DrawOption: E1][P0
Histogram.PtD.MarkerStyle: kOpenCircle
Histogram.PtD.MarkerSize: 0.8

Histogram.JetArea.Name: hJetArea
Histogram.JetArea.Title: Jet Area;Area;Entries
Histogram.JetArea.Bins: 50
Histogram.JetArea.XMin: 0
Histogram.JetArea.XMax: 1
Histogram.JetArea.LogY: 0
Histogram.JetArea.PlotType: 1D
Histogram.JetArea.Color: auto
Histogram.JetArea.LineWidth: 2
