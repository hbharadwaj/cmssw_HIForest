Histogram.IntJetMulti.Name: hIntJetMulti
Histogram.IntJetMulti.Title: Intra Jet Multiplicity;Intra Jet Multiplicity;Entries
Histogram.IntJetMulti.Bins: 15
Histogram.IntJetMulti.XMin: 0
Histogram.IntJetMulti.XMax: 15
Histogram.IntJetMulti.LogY: 0
Histogram.IntJetMulti.PlotType: 1D
